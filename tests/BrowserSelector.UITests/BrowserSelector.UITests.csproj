<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseWPF>true</UseWPF>
    <!-- UIテストの並列実行を有効化（STAスレッド問題を解決） -->
    <MSTestParallelize>true</MSTestParallelize>
    <MSTestWorkers>4</MSTestWorkers>
    <MSTestParallelizeWorkers>4</MSTestParallelizeWorkers>
    <MSTestParallelizeScope>MethodLevel</MSTestParallelizeScope>
    <!-- 追加の並列実行設定 -->
    <MSTestV2Parallelize>true</MSTestV2Parallelize>
    <MSTestV2Workers>4</MSTestV2Workers>
    <MSTestV2ParallelizeWorkers>4</MSTestV2ParallelizeWorkers>
    <MSTestV2ParallelizeScope>MethodLevel</MSTestV2ParallelizeScope>
    <!-- 並列実行有効化 -->
    <Parallelize>true</Parallelize>
    <MaxParallelThreads>4</MaxParallelThreads>
    <DisableParallelization>false</DisableParallelization>
    <!-- UIテスト専用のカバレッジ測定（簡素化） -->
    <CollectCoverage>false</CollectCoverage>
    <!-- テストプロジェクトの警告を無効化（テストコードの特性上、多くの警告は対処困難または不要） -->
    <NoWarn>$(NoWarn);CS0168;SYSLIB0006;S101;CA1063;CA1816;S3881;SA1201;SA1202;SA1137;SA1503;SA1127;CA1805;S2933;SA0001;SA1124;SA1513;SA1028;SA1122;SA1500;SA1508;SA1515;SA1117;SA1116;SA1108;SA1005;SA1009;SA1025;SA1028;SA1505;SA1507;SA1518;SA1111;CA1031;CA1062;CA1303;CA1305;CA1054;CA1822;CA2213;CA2201;S1075;S108;S6561;S1144;S2699;S6605;S6602;CA1851;CA1869;CA1849;CA1707;SA1010;S2925;SA1210;SA1119;SA1501;S1135</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BrowserSelector.App\BrowserSelector.App.csproj" />
    <ProjectReference Include="..\..\src\BrowserSelector.Core\BrowserSelector.Core.csproj" />
    <ProjectReference Include="..\..\src\BrowserSelector.Infrastructure\BrowserSelector.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\BrowserSelector.Presentation\BrowserSelector.Presentation.csproj" />
  </ItemGroup>

</Project>
