<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Updaterプロジェクト専用のカバレッジ測定 -->
    <CollectCoverage>false</CollectCoverage>
    <CoverletOutputFormat>cobertura</CoverletOutputFormat>
    <CoverletOutput>./TestResults/</CoverletOutput>
    <Include>[BrowserSelector.Updater]*</Include>
    <Exclude>[*.Tests]*</Exclude>
    <Exclude>[xunit.*]*</Exclude>
    <Exclude>[FluentAssertions]*</Exclude>
    <Exclude>[Microsoft.*]*</Exclude>
    <Exclude>[System.*]*</Exclude>
    <SkipAutoProps>true</SkipAutoProps>
    <UseSourceLink>true</UseSourceLink>
    <IncludeTestAssembly>false</IncludeTestAssembly>
    <!-- テストプロジェクトの警告を無効化（他のテストプロジェクトと同じ方針） -->
    <NoWarn>$(NoWarn);CS0168;CS8602;CS8604;S101;CA1063;CA1816;S3881;SA1201;SA1202;SA1137;SA1503;SA1127;CA1805;S2933;SA0001;SA1124;SA1513;SA1028;SA1122;SA1500;SA1508;SA1515;SA1117;SA1116;SA1108;SA1005;SA1009;SA1025;SA1505;SA1507;SA1518;SA1111;CA1031;CA1062;CA1303;CA1305;CA1054;CA1822;CA2213;CA2201;S1075;S108;S6561;S1144;S2699;CA1851;CA1869;CA1849;CA1707;SA1010;S2925;SA1210;SA1119;SA1501;S1135;CA1052;CA1310;CA1724;S125;S4144;SA1512;CA1304;CA1307;CA1311;CA1508;CA1862;S6966;CA2234</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Updaterプロジェクトのみを参照（Updater自身が依存ゼロであるのと同じ理由） -->
    <ProjectReference Include="..\..\src\BrowserSelector.Updater\BrowserSelector.Updater.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
