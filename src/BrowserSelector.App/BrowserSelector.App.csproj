<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <Content Include="BrowserSelector_Icon_256.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BrowserSelector.Core\BrowserSelector.Core.csproj" />
    <ProjectReference Include="..\BrowserSelector.Infrastructure\BrowserSelector.Infrastructure.csproj" />
    <ProjectReference Include="..\BrowserSelector.Presentation\BrowserSelector.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>BrowserSelector_Icon_256.ico</ApplicationIcon>
    <StartupObject>BrowserSelector.App.App</StartupObject>
    <!-- <ApplicationIcon>..\..\BrowserSelector_Icon.ico</ApplicationIcon> -->
  </PropertyGroup>

  <!-- テスト用の設定 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);TEST_MODE</DefineConstants>
  </PropertyGroup>

  <!-- テストモード用の設定 -->
  <PropertyGroup Condition="'$(TestMode)' == 'true'">
    <StartupObject>BrowserSelector.App.TestProgram</StartupObject>
  </PropertyGroup>

</Project>
