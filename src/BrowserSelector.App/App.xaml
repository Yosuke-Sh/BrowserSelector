<Application x:Class="BrowserSelector.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BrowserSelector.App">
    <Application.Resources>
        <!-- グローバルコンバーター -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!--
            グローバルなTextBox/TextBlockスタイルは Resources/Themes/Controls.xaml へ移設した
            （トークン参照によるダークモード対応のため）。Controls.xaml は App.xaml.cs の起動処理内で
            Application.Resources.MergedDictionaries へ動的に追加される。
        -->
    </Application.Resources>
</Application>
