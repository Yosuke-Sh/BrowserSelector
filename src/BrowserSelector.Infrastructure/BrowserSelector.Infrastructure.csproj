<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BrowserSelector.Core\BrowserSelector.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <!-- System.Drawing.Common は net10.0-windows のシェアードフレームワークに含まれるため、
         明示的なPackageReferenceは不要（NU1510）。コード上の using/型参照はそのまま利用可能 -->
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <NoWarn>SA1010;SA1636;CA2227;CA1002;S1075;CA1819;CA1055;SA0001</NoWarn>
    <!-- リリースビルド時のPDBファイル生成を無効化してサイズ削減 -->
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\*.json">
      <LogicalName>BrowserSelector.Infrastructure.Localization.%(Filename).json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
