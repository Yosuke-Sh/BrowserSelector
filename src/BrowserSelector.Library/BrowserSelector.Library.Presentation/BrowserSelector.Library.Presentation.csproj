<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BrowserSelector.Library.Core\BrowserSelector.Library.Core.csproj" />
    <ProjectReference Include="..\BrowserSelector.Library.Infrastructure\BrowserSelector.Library.Infrastructure.csproj" />
    <ProjectReference Include="..\..\BrowserSelector.Presentation\BrowserSelector.Presentation.csproj" />
  </ItemGroup>

</Project>
