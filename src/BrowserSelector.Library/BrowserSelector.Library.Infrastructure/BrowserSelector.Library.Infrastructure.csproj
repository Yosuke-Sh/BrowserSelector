<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
    <NoWarn>SA0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <!-- System.Text.Json は net10.0-windows のシェアードフレームワークに含まれるため、
         明示的なPackageReferenceは不要（NU1510）。コード上の using/型参照はそのまま利用可能 -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BrowserSelector.Library.Core\BrowserSelector.Library.Core.csproj" />
    <ProjectReference Include="..\..\BrowserSelector.Infrastructure\BrowserSelector.Infrastructure.csproj" />
  </ItemGroup>

</Project>
