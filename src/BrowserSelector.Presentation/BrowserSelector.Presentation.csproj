<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BrowserSelector.Core\BrowserSelector.Core.csproj" />
    <ProjectReference Include="..\BrowserSelector.Infrastructure\BrowserSelector.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Images\*.png" />
    <Resource Include="Resources\Images\*.svg" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- UIアプリケーションの特性上、対処困難または不要な警告を無効化 -->
    <NoWarn>$(NoWarn);CA1031;CA1062;CA1063;CA1816;CA1822;CA1823;CA1859;CA2000;CA2007;CA2101;CA2201;CA5392;S3168;S1075;S108;S125;S1481;S2486;S2589;S3267;S3358;S3923;S6605;S6608;S6966;SA1124;SA1507;SA1513;SA1515;SA1512;SA1500;SA1501;SA1503;SA1505;SA1508;SA1108;SA1116;SA1117;SA1119;SA1010;SA1636;CA1303;CA1304;CA1305;CA1307;CA1311;CA1508;CA1849;CA1851;CA1862;CA1869;CA2227;CA1002;CA1819;CA1055;SA0001</NoWarn>
    <!-- リリースビルド時のPDBファイル生成を無効化してサイズ削減 -->
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

</Project>
