<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BrowserSelector.Core\BrowserSelector.Core.csproj" />
    <ProjectReference Include="..\BrowserSelector.Infrastructure\BrowserSelector.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BrowserSelector.UnitTests" />
  </ItemGroup>

  <!-- System.Drawing.Common は net10.0-windows のシェアードフレームワークに含まれるため、
       明示的なPackageReferenceは不要（NU1510）。コード上の using/型参照はそのまま利用可能 -->

  <ItemGroup>
    <Resource Include="Resources\Images\*.png" />
    <Resource Include="Resources\Images\*.svg" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- UIアプリケーションの特性上、対処困難または不要な警告を無効化 -->
    <NoWarn>$(NoWarn);CA1063;CA1816;CA1822;CA1823;CA1859;CA2007;CA2101;CA2201;CA5392;S3168;S1075;S108;S125;S1481;S2486;S2589;S3267;S3358;S3923;S6605;S6608;S6966;SA1124;SA1507;SA1513;SA1515;SA1512;SA1500;SA1501;SA1503;SA1505;SA1508;SA1108;SA1116;SA1117;SA1119;SA1010;SA1636;CA1303;CA1304;CA1305;CA1307;CA1311;CA1508;CA1851;CA1862;CA1869;CA2227;CA1002;CA1819;CA1055;CA1054;CA1056;SA0001</NoWarn>
    <!-- CA1054/CA1056: URLを表すプロパティ・引数は既存コード（MainViewModel.Url等）を含め一貫してstringで
         扱っており、ここだけUriへ変更すると入力途中の不完全な文字列でUri検証エラーが起き、
         ワイルドカードパターン（*.example.com等）を含むURLルールのパターン文字列とも相性が悪いため
         意図的にstringのまま維持する（CA1055と同様の判断） -->

    <!-- SA0001: GenerateDocumentationFile有効化には85件のSA16xx（XMLコメント欠落）是正が別途必要なため、Phase B-6の対象外として今回は現状維持（将来のドキュメント整備フェーズで対応） -->
    <!-- CA1031/CA1062/CA2000/CA1849はPhase B-6で対応済みのため上記リストから除去済み -->
    <!-- リリースビルド時のPDBファイル生成を無効化してサイズ削減 -->
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

</Project>
