<Window x:Class="BrowserSelector.Presentation.Views.BrowserEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BrowserSelector.Presentation.Views"
        xmlns:converters="clr-namespace:BrowserSelector.Presentation.Converters"
        xmlns:extensions="clr-namespace:BrowserSelector.Presentation.Extensions"
        mc:Ignorable="d"
        Title="{extensions:Localization Dialog.BrowserEdit.Title}" Height="450" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinHeight="400" MinWidth="500">

    <Window.Resources>
        <converters:IconPathConverter x:Key="IconPathConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- タイトル -->
        <TextBlock Grid.Row="0" Text="{extensions:Localization Dialog.BrowserEdit.BrowserSettings}" 
                   FontSize="18" FontWeight="Bold" 
                   Margin="0,0,0,20" HorizontalAlignment="Center"/>
        
        <!-- システムブラウザ情報 -->
        <TextBlock x:Name="SystemBrowserInfoText" Grid.Row="0" 
                   Text="{extensions:Localization Dialog.BrowserEdit.SystemBrowserInfo}" 
                   FontSize="12" Foreground="Gray" 
                   Margin="0,25,0,0" HorizontalAlignment="Center" 
                   TextWrapping="Wrap" Visibility="Collapsed"/>

        <!-- メインコンテンツ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 基本情報 -->
                <GroupBox Header="{extensions:Localization Dialog.BrowserEdit.BasicInfo}" Margin="0,0,0,15">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- ブラウザ名 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{extensions:Localization Dialog.BrowserEdit.BrowserName}" 
                                   VerticalAlignment="Center" Margin="0,5"/>
                        <TextBox x:Name="NameTextBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                 Text="{Binding Name}" VerticalAlignment="Center" Margin="0,5"/>

                        <!-- 実行ファイルパス -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{extensions:Localization Dialog.BrowserEdit.ExecutablePath}" 
                                   VerticalAlignment="Center" Margin="0,5"/>
                        <TextBox x:Name="ExecutablePathTextBox" Grid.Row="1" Grid.Column="1" 
                                 Text="{Binding ExecutablePath}" VerticalAlignment="Center" 
                                 Margin="0,5" IsReadOnly="True"/>
                        <Button x:Name="BrowseExecutableButton" Grid.Row="1" Grid.Column="2" Content="{extensions:Localization Common.Browse}" 
                                Padding="10,5" Margin="5,5,0,5" Click="BrowseExecutable_Click"/>

                        <!-- アイコンパス -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{extensions:Localization Dialog.BrowserEdit.Icon}" 
                                   VerticalAlignment="Center" Margin="0,5"/>
                        <TextBox Grid.Row="2" Grid.Column="1" 
                                 Text="{Binding IconPath}" VerticalAlignment="Center" 
                                 Margin="0,5" IsReadOnly="True"/>
                        <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Margin="5,5,0,5">
                            <Button Content="{extensions:Localization Common.Browse}" Padding="10,5" Margin="0,0,5,0" Click="BrowseIcon_Click"/>
                            <Button Content="{extensions:Localization Common.Select}" Padding="10,5" Click="SelectIcon_Click" 
                                    ToolTip="{extensions:Localization Dialog.BrowserEdit.SelectIconTooltip}"/>
                        </StackPanel>

                        <!-- 起動パラメータ -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{extensions:Localization Dialog.BrowserEdit.LaunchParameters}" 
                                   VerticalAlignment="Center" Margin="0,5"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                 Text="{Binding Arguments}" VerticalAlignment="Center" 
                                 Margin="0,5" ToolTip="{extensions:Localization Dialog.BrowserEdit.LaunchParametersTooltip}"/>
                    </Grid>
                </GroupBox>

                <!-- 表示設定 -->
                <GroupBox Header="{extensions:Localization Dialog.BrowserEdit.DisplaySettings}" Margin="0,0,0,15">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 表示順序 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{extensions:Localization Dialog.BrowserEdit.DisplayOrder}" 
                                   VerticalAlignment="Center" Margin="0,5"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox Text="{Binding DisplayOrder}" Width="60" Margin="0,5,5,5" 
                                     ToolTip="{extensions:Localization Dialog.BrowserEdit.DisplayOrderTooltip}"/>
                            <Button Content="↑" Width="25" Height="25" Margin="2,0" Click="MoveUp_Click" 
                                    ToolTip="{extensions:Localization Dialog.BrowserEdit.MoveUpTooltip}"/>
                            <Button Content="↓" Width="25" Height="25" Margin="2,0" Click="MoveDown_Click" 
                                    ToolTip="{extensions:Localization Dialog.BrowserEdit.MoveDownTooltip}"/>
                        </StackPanel>

                        <!-- 有効/無効 -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{extensions:Localization Dialog.BrowserEdit.Enabled}" 
                                   VerticalAlignment="Center" Margin="0,5"/>
                        <CheckBox Grid.Row="1" Grid.Column="1" 
                                  IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" 
                                  Margin="0,5" Content="{extensions:Localization Dialog.BrowserEdit.EnableBrowser}"/>
                    </Grid>
                </GroupBox>

                <!-- プレビュー -->
                <GroupBox Header="{extensions:Localization Dialog.BrowserEdit.Preview}" Margin="0,0,0,15">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- アイコン表示 -->
                        <Image Grid.Column="0" Width="32" Height="32" Margin="0,0,10,0"
                               Stretch="Uniform">
                            <Image.Source>
                                <MultiBinding Converter="{StaticResource IconPathConverter}">
                                    <Binding Path="IconPath"/>
                                    <Binding Path="ExecutablePath"/>
                                    <Binding Path="Name"/>
                                </MultiBinding>
                            </Image.Source>
                        </Image>
                        
                        <!-- ブラウザ情報 -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding ExecutablePath}" 
                                       FontSize="10" Foreground="Gray"/>
                            <TextBlock Text="{Binding Type}" 
                                       FontSize="10" Foreground="Blue"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- ボタン -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" 
                    HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{extensions:Localization Common.OK}" Width="80" Height="30" 
                    Margin="0,0,10,0" Click="OkButton_Click"/>
            <Button Content="{extensions:Localization Common.Cancel}" Width="80" Height="30" 
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
