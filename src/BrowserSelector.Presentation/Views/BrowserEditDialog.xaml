<Window x:Class="BrowserSelector.Presentation.Views.BrowserEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BrowserSelector.Presentation.Views"
        mc:Ignorable="d"
        Title="ブラウザ編集" Height="450" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinHeight="400" MinWidth="500">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- タイトル -->
        <TextBlock Grid.Row="0" Text="ブラウザ設定" 
                   FontSize="18" FontWeight="Bold" 
                   Margin="0,0,0,20" HorizontalAlignment="Center"/>
        
        <!-- システムブラウザ情報 -->
        <TextBlock x:Name="SystemBrowserInfoText" Grid.Row="0" 
                   Text="システムで検出されたブラウザです。名前と実行ファイルパスは変更できません。" 
                   FontSize="12" Foreground="Gray" 
                   Margin="0,25,0,0" HorizontalAlignment="Center" 
                   TextWrapping="Wrap" Visibility="Collapsed"/>

        <!-- メインコンテンツ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 基本情報 -->
                <GroupBox Header="基本情報" Margin="0,0,0,15">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- ブラウザ名 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="ブラウザ名:" 
                                   VerticalAlignment="Center" Margin="0,5"/>
                        <TextBox x:Name="NameTextBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                 Text="{Binding Name}" VerticalAlignment="Center" Margin="0,5"/>

                        <!-- 実行ファイルパス -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="実行ファイル:" 
                                   VerticalAlignment="Center" Margin="0,5"/>
                        <TextBox x:Name="ExecutablePathTextBox" Grid.Row="1" Grid.Column="1" 
                                 Text="{Binding ExecutablePath}" VerticalAlignment="Center" 
                                 Margin="0,5" IsReadOnly="True"/>
                        <Button x:Name="BrowseExecutableButton" Grid.Row="1" Grid.Column="2" Content="参照..." 
                                Padding="10,5" Margin="5,5,0,5" Click="BrowseExecutable_Click"/>

                        <!-- アイコンパス -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="アイコン:" 
                                   VerticalAlignment="Center" Margin="0,5"/>
                        <TextBox Grid.Row="2" Grid.Column="1" 
                                 Text="{Binding IconPath}" VerticalAlignment="Center" 
                                 Margin="0,5" IsReadOnly="True"/>
                        <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Margin="5,5,0,5">
                            <Button Content="参照..." Padding="10,5" Margin="0,0,5,0" Click="BrowseIcon_Click"/>
                            <Button Content="選択" Padding="10,5" Click="SelectIcon_Click" 
                                    ToolTip="アイコン選択画面を開く"/>
                        </StackPanel>

                        <!-- 起動パラメータ -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="起動パラメータ:" 
                                   VerticalAlignment="Center" Margin="0,5"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                 Text="{Binding Arguments}" VerticalAlignment="Center" 
                                 Margin="0,5" ToolTip="URLの後に追加される起動パラメータ"/>
                    </Grid>
                </GroupBox>

                <!-- 表示設定 -->
                <GroupBox Header="表示設定" Margin="0,0,0,15">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 表示順序 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="表示順序:" 
                                   VerticalAlignment="Center" Margin="0,5"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox Text="{Binding DisplayOrder}" Width="60" Margin="0,5,5,5" 
                                     ToolTip="小さい数字が先に表示されます"/>
                            <Button Content="↑" Width="25" Height="25" Margin="2,0" Click="MoveUp_Click" 
                                    ToolTip="順序を上げる"/>
                            <Button Content="↓" Width="25" Height="25" Margin="2,0" Click="MoveDown_Click" 
                                    ToolTip="順序を下げる"/>
                        </StackPanel>

                        <!-- 有効/無効 -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="有効:" 
                                   VerticalAlignment="Center" Margin="0,5"/>
                        <CheckBox Grid.Row="1" Grid.Column="1" 
                                  IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" 
                                  Margin="0,5" Content="このブラウザを使用可能にする"/>
                    </Grid>
                </GroupBox>

                <!-- プレビュー -->
                <GroupBox Header="プレビュー" Margin="0,0,0,15">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- アイコン表示 -->
                        <Image Grid.Column="0" Source="{Binding IconPath}" 
                               Width="32" Height="32" Margin="0,0,10,0"
                               Stretch="Uniform"/>
                        
                        <!-- ブラウザ情報 -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding ExecutablePath}" 
                                       FontSize="10" Foreground="Gray"/>
                            <TextBlock Text="{Binding Type}" 
                                       FontSize="10" Foreground="Blue"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- ボタン -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" 
                    HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="OK" Width="80" Height="30" 
                    Margin="0,0,10,0" Click="OkButton_Click"/>
            <Button Content="キャンセル" Width="80" Height="30" 
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
