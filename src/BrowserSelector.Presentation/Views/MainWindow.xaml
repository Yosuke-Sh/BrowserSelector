<Window x:Class="BrowserSelector.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:BrowserSelector.Presentation.ViewModels"

        xmlns:converters="clr-namespace:BrowserSelector.Presentation.Converters"
        mc:Ignorable="d"
        Title="BrowserSelector" 
        Height="600" 
        Width="800"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        ShowInTaskbar="True"
        Icon="/BrowserSelector.Presentation;component/Resources/Images/BrowserSelector_Icon_32.png"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
        DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <Window.Resources>
        <!-- コンバーター -->
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:StringToBoolConverter x:Key="StringToBoolConverter"/>

        <!-- スタイル定義 -->
        <Style x:Key="BrowserButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="90"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Grid Grid.Row="0" Margin="20,20,20,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ロゴ（左上） -->
            <Image Grid.Column="0"
                   Source="/BrowserSelector.Presentation;component/Resources/Images/BrowserSelector_Logo_240.png"
                   Width="157" 
                   Height="79"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="-15,-9,0,0"
                   RenderOptions.BitmapScalingMode="HighQuality" Grid.ColumnSpan="2"/>

            <!-- タイトルテキスト（中央） -->
            <TextBlock Grid.Column="1"
                       Text="{Binding TitleMessage}"
                       FontSize="20" 
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Width="443"
                       >
                <TextBlock.Effect>
                    <DropShadowEffect
                          ShadowDepth="3"
                          Direction="330"
                          Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}"
                          Opacity="0.5"
                         BlurRadius="2"/>
                </TextBlock.Effect>
                <TextBlock.Background>
                    <SolidColorBrush  Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" Opacity="0.25"/>
                </TextBlock.Background>
            </TextBlock>
        </Grid>

        <!-- URLが指定されている場合の表示 -->
        <TextBlock Grid.Row="0" 
                   Text="{Binding Url, StringFormat='URL: {0}'}"
                   FontSize="14" 
                   HorizontalAlignment="Center"
                   Margin="20,70,20,0"
                   Foreground="#666666"
                   Visibility="{Binding Url, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- URL入力 -->
        <Grid Grid.Row="1" Margin="20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                          FontSize="16"
                          Padding="40,8,10,8"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center"
                          Background="#FAFAFA"
                          BorderBrush="#E0E0E0"
                          BorderThickness="1">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                <VisualBrush.Visual>
                                                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                                                        <Image Source="/BrowserSelector.Presentation;component/Resources/Images/Icon_Globe.png"
                                                                Width="16" Height="16" Margin="0,0,8,0"/>
                                                        <TextBlock Text="URLを入力してください..." 
                                                                    Foreground="Gray" 
                                                                    FontSize="16" 
                                                                    VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- グローブアイコン（常時表示） -->
                <Image Source="/BrowserSelector.Presentation;component/Resources/Images/Icon_Globe.png"
                        Width="16" Height="16" 
                        HorizontalAlignment="Left" 
                        VerticalAlignment="Center"
                        Margin="12,0,0,0"
                        Opacity="0.6"/>
            </Grid>

            <Button Grid.Column="1"
                     Command="{Binding OpenSettingsCommand}"
                     Padding="15,8"
                     VerticalAlignment="Center"
                     Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                     Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                     BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                     BorderThickness="1"
                     Cursor="Hand">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/BrowserSelector.Presentation;component/Resources/Images/Icon_Settings_Gray.png"
                            Width="16" Height="16" 
                            Margin="0,0,8,0"/>
                    <TextBlock Text="設定" 
                                FontSize="14" 
                                FontWeight="Medium"
                                VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ブラウザ一覧 -->
        <Grid Grid.Row="2" Margin="20,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Browsers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource BrowserButtonStyle}"
                                    Command="{Binding DataContext.LaunchBrowserCommand, 
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Content="{Binding DisplayName}"
                                    Click="BrowserButton_Click"
                                    IsEnabled="{Binding DataContext.Url, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringToBoolConverter}}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- テスト用の固定コンテンツ -->
            <StackPanel HorizontalAlignment="Center" 
                        VerticalAlignment="Center"
                        Visibility="{Binding Browsers.Count, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                <TextBlock Text="🔍 ブラウザを検出中..." 
                           FontSize="18" 
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"
                           Foreground="{Binding VisualSettings.MessageTextColor}"/>
                <TextBlock Text="システムにインストールされたブラウザを自動検出しています。" 
                           FontSize="14" 
                           HorizontalAlignment="Center"
                           Foreground="{Binding VisualSettings.MessageTextColor}"/>
            </StackPanel>
        </Grid>

        <!-- ステータス -->
        <TextBlock Grid.Row="3" 
                   Text="{Binding StatusMessage}"
                   Style="{StaticResource StatusTextStyle}"/>

        <!-- ローディング表示 -->
        <Grid Grid.Row="2" 
              Background="#80000000"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
              Panel.ZIndex="1000">
            <StackPanel HorizontalAlignment="Center" 
                        VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" 
                             Width="100" 
                             Height="4" 
                             Margin="0,0,0,10"/>
                <TextBlock Text="読み込み中..." 
                           Foreground="White" 
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
