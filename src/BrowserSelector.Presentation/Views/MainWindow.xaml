<Window x:Class="BrowserSelector.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:BrowserSelector.Presentation.ViewModels"

        xmlns:converters="clr-namespace:BrowserSelector.Presentation.Converters"
        xmlns:extensions="clr-namespace:BrowserSelector.Presentation.Extensions"
        mc:Ignorable="d"
        Title="{extensions:Localization MainWindow.Title}" 
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        ShowInTaskbar="True"
        Icon="/BrowserSelector.Presentation;component/Resources/Images/BrowserSelector_Icon_32.png"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
        DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <Window.Resources>
        <!-- コンバーター -->
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:StringToBoolConverter x:Key="StringToBoolConverter"/>
        <converters:IconPathConverter x:Key="IconPathConverter"/>
        <converters:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
        <converters:IconSizeConverter x:Key="IconSizeConverter"/>
        <converters:IconMarginConverter x:Key="IconMarginConverter"/>

        <!-- スタイル定義 -->
        <Style x:Key="BrowserButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{Binding DataContext.VisualSettings.BrowserButtonBackgroundColor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ColorToBrushConverter}}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{Binding DataContext.VisualSettings.BrowserButtonCornerRadius, RelativeSource={RelativeSource AncestorType=Window}}"
                                Opacity="{Binding DataContext.VisualSettings.BrowserButtonOpacity, RelativeSource={RelativeSource AncestorType=Window}}"
                                Width="{Binding DataContext.VisualSettings.BrowserButtonWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                Height="{Binding DataContext.VisualSettings.BrowserButtonHeight, RelativeSource={RelativeSource AncestorType=Window}}">
                            <StackPanel Orientation="Vertical" 
                                        HorizontalAlignment="Center" 
                                        VerticalAlignment="Center">
                                <Image RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Width>
                                        <MultiBinding Converter="{StaticResource IconSizeConverter}">
                                            <Binding Path="DataContext.VisualSettings.BrowserIconSize" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                            <Binding Path="DataContext.VisualSettings.ShowBrowserName" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        </MultiBinding>
                                    </Image.Width>
                                    <Image.Height>
                                        <MultiBinding Converter="{StaticResource IconSizeConverter}">
                                            <Binding Path="DataContext.VisualSettings.BrowserIconSize" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                            <Binding Path="DataContext.VisualSettings.ShowBrowserName" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        </MultiBinding>
                                    </Image.Height>
                                    <Image.Margin>
                                        <Binding Path="DataContext.VisualSettings.ShowBrowserName" RelativeSource="{RelativeSource AncestorType=Window}" Converter="{StaticResource IconMarginConverter}"/>
                                    </Image.Margin>
                                    <Image.Source>
                                        <MultiBinding Converter="{StaticResource IconPathConverter}">
                                            <Binding Path="IconPath"/>
                                            <Binding Path="ExecutablePath"/>
                                            <Binding Path="Name"/>
                                        </MultiBinding>
                                    </Image.Source>
                                </Image>
                                <TextBlock Text="{TemplateBinding Content}" 
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxWidth="100"
                                           Foreground="{Binding DataContext.VisualSettings.BrowserButtonForegroundColor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ColorToBrushConverter}}"
                                           Visibility="{Binding DataContext.VisualSettings.ShowBrowserName, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                                <Setter Property="Background" Value="#F0F0F0"/>
                                <Setter Property="BorderBrush" Value="#D0D0D0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E3F2FD"/>
                                <Setter Property="BorderBrush" Value="#2196F3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 背景 -->
        <Border Grid.RowSpan="4" 
                Background="{Binding VisualSettings.BackgroundColor, Converter={StaticResource ColorToBrushConverter}}"/>

        <!-- ヘッダー -->
        <Grid Grid.Row="0" Margin="20,20,20,15" 
              Visibility="{Binding VisualSettings.ShowLogo, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ロゴ（左上） -->
            <Image Grid.Column="0"
                   Source="/BrowserSelector.Presentation;component/Resources/Images/BrowserSelector_Logo_240.png"
                   Width="157" 
                   Height="79"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="-15,-9,0,0"
                   RenderOptions.BitmapScalingMode="HighQuality" Grid.ColumnSpan="2"/>

            <!-- タイトルテキスト（中央） -->
            <TextBlock Grid.Column="1"
                       Text="{Binding TitleMessage}"
                       FontSize="20" 
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Width="443"
                       >
                <TextBlock.Effect>
                    <DropShadowEffect
                          ShadowDepth="3"
                          Direction="330"
                          Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}"
                          Opacity="0.5"
                         BlurRadius="2"/>
                </TextBlock.Effect>
                <TextBlock.Background>
                    <SolidColorBrush  Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" Opacity="0.10"/>
                </TextBlock.Background>
            </TextBlock>
        </Grid>

        <!-- URLが指定されている場合の表示 -->
        <TextBlock Grid.Row="0" 
                   Text="{Binding Url, StringFormat='URL: {0}'}"
                   FontSize="14" 
                   HorizontalAlignment="Center"
                   Margin="20,70,20,0"
                   Foreground="#666666"
                   Visibility="{Binding Url, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- URL入力 -->
        <Grid Grid.Row="1" Margin="20,10" 
              Visibility="{Binding VisualSettings.ShowUrlInput, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                          FontSize="16"
                          Padding="40,8,10,8"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center"
                          Background="#FAFAFA"
                          BorderBrush="#E0E0E0"
                          BorderThickness="1">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                <VisualBrush.Visual>
                                                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                                                        <Image Source="/BrowserSelector.Presentation;component/Resources/Images/Icon_Globe.png"
                                                                Width="16" Height="16" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{extensions:Localization MainWindow.UrlPrompt}" 
                                                                    Foreground="Gray" 
                                                                    FontSize="16" 
                                                                    VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- グローブアイコン（常時表示） -->
                <Image Source="/BrowserSelector.Presentation;component/Resources/Images/Icon_Globe.png"
                        Width="16" Height="16" 
                        HorizontalAlignment="Left" 
                        VerticalAlignment="Center"
                        Margin="12,0,0,0"
                        Opacity="0.6"/>
            </Grid>

        </Grid>

        <!-- ブラウザ一覧 -->
        <Grid Grid.Row="2" Margin="20,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Browsers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource BrowserButtonStyle}"
                                    Command="{Binding DataContext.LaunchBrowserCommand, 
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Content="{Binding DisplayName}"
                                    Click="BrowserButton_Click"
                                    IsEnabled="{Binding DataContext.Url, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringToBoolConverter}}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 設定ボタン -->
            <Button Grid.Row="1"
                     Command="{Binding OpenSettingsCommand}"
                     Padding="15,8"
                     Margin="0,10,0,0"
                     HorizontalAlignment="Center"
                     Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                     Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                     BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                     BorderThickness="1"
                     Cursor="Hand">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/BrowserSelector.Presentation;component/Resources/Images/Icon_Settings_Gray.png"
                            Width="16" Height="16" 
                            Margin="0,0,8,0"/>
                    <TextBlock Text="{extensions:Localization MainWindow.Settings}" 
                                FontSize="14" 
                                FontWeight="Medium"
                                VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- テスト用の固定コンテンツ -->
            <StackPanel HorizontalAlignment="Center" 
                        VerticalAlignment="Center"
                        Visibility="{Binding Browsers.Count, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                <TextBlock Text="{extensions:Localization MainWindow.DetectingBrowsers}" 
                           FontSize="18" 
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"
                           Foreground="{Binding VisualSettings.MessageTextColor}"/>
                <TextBlock Text="{extensions:Localization MainWindow.DetectingBrowsersDescription}" 
                           FontSize="14" 
                           HorizontalAlignment="Center"
                           Foreground="{Binding VisualSettings.MessageTextColor}"/>
            </StackPanel>
        </Grid>

        <!-- ステータス -->
        <TextBlock Grid.Row="3" 
                   Text="{Binding StatusMessage}"
                   Style="{StaticResource StatusTextStyle}"/>

        <!-- ローディング表示 -->
        <Grid Grid.Row="2" 
              Background="#80000000"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
              Panel.ZIndex="1000">
            <StackPanel HorizontalAlignment="Center" 
                        VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" 
                             Width="100" 
                             Height="4" 
                             Margin="0,0,0,10"/>
                <TextBlock Text="{extensions:Localization MainWindow.Loading}" 
                           Foreground="White" 
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
