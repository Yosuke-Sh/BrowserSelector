    <Window x:Class="BrowserSelector.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:viewmodels="clr-namespace:BrowserSelector.Presentation.ViewModels"

        xmlns:converters="clr-namespace:BrowserSelector.Presentation.Converters"
        xmlns:extensions="clr-namespace:BrowserSelector.Presentation.Extensions"
        mc:Ignorable="d"
        Title="{extensions:Localization MainWindow.Title}"
        WindowStartupLocation="Manual"
        WindowState="Normal"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        MinWidth="400"
        MinHeight="300"
        ShowInTaskbar="True"
        Icon="/BrowserSelector.Presentation;component/Resources/Images/BrowserSelector_Icon_32.png"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        AutomationProperties.Name="MainWindow">

    <!--
        透明化方式（決定事項・Phase C-1/C-2）: AllowsTransparencyは使わず、
        WindowStyle=None + WindowChrome(GlassFrameThickness=-1) + DwmSetWindowAttribute(SYSTEMBACKDROP_TYPE)
        の組み合わせでガラス化する。これによりウィンドウ全体のソフトウェアレンダリング化を避け、
        ブラウザアイコンを不透明・GPUレンダリングのまま鮮明に保つ。
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="-1"
                             CaptionHeight="36"
                             ResizeBorderThickness="6"
                             CornerRadius="0"
                             UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- コンバーター -->
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:StringToBoolConverter x:Key="StringToBoolConverter"/>
        <converters:IconPathConverter x:Key="IconPathConverter"/>
        <converters:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
        <converters:ElevationShadowBrushConverter x:Key="ElevationShadowBrushConverter"/>
        <converters:IconSizeConverter x:Key="IconSizeConverter"/>
        <converters:IconMarginConverter x:Key="IconMarginConverter"/>
        <converters:BackgroundBrushConverter x:Key="BackgroundBrushConverter"/>
        <converters:IndexToHotkeyBadgeConverter x:Key="IndexToHotkeyBadgeConverter"/>
        <converters:BrowserTooltipConverter x:Key="BrowserTooltipConverter"/>

        <!-- タイトルバーボタン共通スタイル（最小化・設定）。閉じるボタンのみ別スタイルで赤系ホバーにする -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- タイトルバー非表示時、右上に常時表示されるハンバーガーメニュー（Grid.RowSpan="6"）と
             コンテンツ行の右上が重ならないよう、右マージンを追加する共通スタイル。
             URL入力行・ブラウザ一覧行の両方で共有する。 -->
        <Style x:Key="TitleBarAwareContentMargin" TargetType="Grid">
            <Setter Property="Margin" Value="20,10"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowTitleBar}" Value="False">
                    <Setter Property="Margin" Value="20,10,54,10"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ブラウザタイル（Phase C-3: ホバー・フォーカス・スケールアニメーション対応、Phase C-7: エレベーション表現） -->
        <Style x:Key="BrowserButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="{Binding DataContext.VisualSettings.BrowserButtonWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                              Height="{Binding DataContext.VisualSettings.BrowserButtonHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                            <!-- エレベーション: 半透明の重ねたBorderで影を疑似表現（DropShadowEffectはWPFで重いため不採用、CacheModeも併用）。
                                 影の色はボタン背景色から生成する（ElevationShadowBrushConverter）。背景が透明（既定値）の
                                 場合はBrush.ElevationShadowへフォールバックする。
                                 タイルと同じGridに幅・高さを固定したことで、ウィンドウ幅が広がってもセルいっぱいに
                                 伸びなくなる（従来はShadowにサイズ指定が無くUniformGridのセル全体に伸びていた不具合）。 -->
                            <Border x:Name="Shadow"
                                    Background="{Binding DataContext.VisualSettings.BrowserButtonBackgroundColor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ElevationShadowBrushConverter}}"
                                    CornerRadius="{Binding DataContext.VisualSettings.BrowserButtonCornerRadius, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Margin="2,3,-2,-3"
                                    CacheMode="BitmapCache"/>

                            <!-- ベベル表現（TileElevationStyle=Bevel時のみ表示）: 上辺を明るく・下辺を暗くする
                                 対角グラデーションの縁取りで立体感を表現する。既定では非表示。 -->
                            <Border x:Name="Bevel"
                                    BorderThickness="2"
                                    CornerRadius="{Binding DataContext.VisualSettings.BrowserButtonCornerRadius, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#66FFFFFF" Offset="0"/>
                                        <GradientStop Color="#66000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                            </Border>

                            <!-- 枠線表現（TileElevationStyle=Outline時のみ表示）: アクセント色の縁取りで
                                 浮き上がりを表現する。既定では非表示。 -->
                            <Border x:Name="Outline"
                                    BorderBrush="{DynamicResource Brush.Accent}"
                                    BorderThickness="1.5"
                                    CornerRadius="{Binding DataContext.VisualSettings.BrowserButtonCornerRadius, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False"/>

                            <Border x:Name="Root"
                                    Background="{Binding DataContext.VisualSettings.BrowserButtonBackgroundColor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ColorToBrushConverter}}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{Binding DataContext.VisualSettings.BrowserButtonCornerRadius, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Opacity="{Binding DataContext.VisualSettings.BrowserButtonOpacity, RelativeSource={RelativeSource AncestorType=Window}}"
                                    RenderTransformOrigin="0.5,0.5"
                                    CacheMode="BitmapCache">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="RootScale" ScaleX="1.0" ScaleY="1.0"/>
                                </Border.RenderTransform>
                                <StackPanel Orientation="Vertical"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <Image RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.Width>
                                            <MultiBinding Converter="{StaticResource IconSizeConverter}">
                                                <Binding Path="DataContext.VisualSettings.BrowserIconSize" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                <Binding Path="DataContext.VisualSettings.ShowBrowserName" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                            </MultiBinding>
                                        </Image.Width>
                                        <Image.Height>
                                            <MultiBinding Converter="{StaticResource IconSizeConverter}">
                                                <Binding Path="DataContext.VisualSettings.BrowserIconSize" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                <Binding Path="DataContext.VisualSettings.ShowBrowserName" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                            </MultiBinding>
                                        </Image.Height>
                                        <Image.Margin>
                                            <Binding Path="DataContext.VisualSettings.ShowBrowserName" RelativeSource="{RelativeSource AncestorType=Window}" Converter="{StaticResource IconMarginConverter}"/>
                                        </Image.Margin>
                                        <Image.Source>
                                            <MultiBinding Converter="{StaticResource IconPathConverter}">
                                                <Binding Path="IconPath"/>
                                                <Binding Path="ExecutablePath"/>
                                                <Binding Path="Name"/>
                                                <Binding Path="IconIndex"/>
                                            </MultiBinding>
                                        </Image.Source>
                                    </Image>
                                    <TextBlock Text="{TemplateBinding Content}"
                                               HorizontalAlignment="Center"
                                               TextWrapping="Wrap"
                                               MaxWidth="100"
                                               Foreground="{Binding DataContext.VisualSettings.BrowserButtonForegroundColor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ColorToBrushConverter}}"
                                               Visibility="{Binding DataContext.VisualSettings.ShowBrowserName, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </Border>

                            <!-- ホットキー／既定ブラウザバッジ（左上） -->
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Margin="4"
                                    Background="{DynamicResource Brush.Accent}"
                                    CornerRadius="8"
                                    Padding="5,1"
                                    Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{extensions:Localization MainWindow.DefaultBrowserBadge}"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.TextOnAccent}"/>
                            </Border>

                            <!-- ホットキーバッジ（右上、既定バッジと重ならないよう反対側に配置。
                                 タイル本体と同じ固定サイズGrid内に置くことで、ボタンがUniformGridの
                                 セル全体に伸びてもバッジがタイルの外にずれないようにする。 -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="4"
                                    Background="{DynamicResource Brush.SurfaceAlt}"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="5,1"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource IndexToHotkeyBadgeConverter}, ConverterParameter=Visibility}">
                                <TextBlock FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.TextSecondary}"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource IndexToHotkeyBadgeConverter}}"/>
                            </Border>

                            <!-- フォーカスリング（VisualSettings.FocusColor/FocusThicknessを流用） -->
                            <Border x:Name="FocusRing"
                                    BorderBrush="{Binding DataContext.VisualSettings.FocusColor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ColorToBrushConverter}}"
                                    BorderThickness="{Binding DataContext.VisualSettings.FocusThickness, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CornerRadius="{Binding DataContext.VisualSettings.BrowserButtonCornerRadius, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Margin="-2"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- タイルの立体表現方式（VisualSettings.TileElevationStyle）。
                                 IsEnabled=Falseトリガーより前に置き、無効化時は後勝ちでShadow等が
                                 確実にCollapsedになるようにする。 -->
                            <DataTrigger Binding="{Binding DataContext.VisualSettings.TileElevationStyle, RelativeSource={RelativeSource AncestorType=Window}}" Value="None">
                                <Setter TargetName="Shadow" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DataContext.VisualSettings.TileElevationStyle, RelativeSource={RelativeSource AncestorType=Window}}" Value="Bevel">
                                <Setter TargetName="Shadow" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Bevel" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DataContext.VisualSettings.TileElevationStyle, RelativeSource={RelativeSource AncestorType=Window}}" Value="Outline">
                                <Setter TargetName="Shadow" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Outline" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5"/>
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.SurfaceDisabled}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
                                <Setter TargetName="Shadow" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Bevel" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Outline" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding DataContext.VisualSettings.ShowFocusIndicator, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                <Setter TargetName="FocusRing" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <!-- Phase C-4: キーボード操作。Esc/Enter/Space/矢印キー/ホットキーはPreviewKeyDownで処理（列数計算等の共有ロジックが必要なため） -->
        <KeyBinding Modifiers="Ctrl" Key="OemComma" Command="{Binding OpenSettingsCommand}"/>
    </Window.InputBindings>

    <Grid AutomationProperties.Name="MainContentGrid" PreviewKeyDown="OnPreviewKeyDown" PreviewMouseMove="MainWindow_PreviewMouseMove">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="CustomTitleBarRow" Height="36"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 背景（ガラス効果無効時のフォールバック。有効時はWindow.Background=Transparentのまま） -->
        <Border Grid.RowSpan="6"
                Background="{Binding VisualSettings, Converter={StaticResource BackgroundBrushConverter}}"/>

        <!-- ハンバーガーメニュー（Phase E-3: タイトルバー非表示時の代替導線）。
             ShowTitleBar=falseの場合、CustomTitleBarRowの高さが0になり設定/最小化/閉じるボタンが操作不能になるため、
             常時表示されるオーバーレイとして右上に設定・最小化・閉じるへの導線を提供する。 -->
        <Button Grid.Row="0" Grid.RowSpan="6"
                Style="{StaticResource TitleBarButtonStyle}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Click="HamburgerMenuButton_Click"
                ToolTip="{extensions:Localization MainWindow.HamburgerMenu.Tooltip}"
                Visibility="{Binding ShowTitleBar, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                AutomationProperties.Name="HamburgerMenuButton">
            <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
            <Button.ContextMenu>
                <ContextMenu x:Name="HamburgerContextMenu" Placement="Bottom">
                    <MenuItem Header="{extensions:Localization MainWindow.SettingsButton.Tooltip}"
                              Command="{Binding OpenSettingsCommand}"
                              AutomationProperties.Name="HamburgerMenu_Settings"/>
                    <MenuItem Header="{extensions:Localization MainWindow.MinimizeButton.Tooltip}"
                              Click="MinimizeButton_Click"
                              AutomationProperties.Name="HamburgerMenu_Minimize"/>
                    <Separator/>
                    <MenuItem Header="{extensions:Localization MainWindow.CloseButton.Tooltip}"
                              Click="CloseButton_Click"
                              AutomationProperties.Name="HamburgerMenu_Close"/>
                </ContextMenu>
            </Button.ContextMenu>
        </Button>

        <!-- カスタムタイトルバー（Phase C-2） -->
        <Grid Grid.Row="0" AutomationProperties.Name="CustomTitleBar">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding TitleMessage}"
                       FontSize="12"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       TextTrimming="CharacterEllipsis"/>

            <!-- カウントダウン自動起動の残り秒数（Phase D） -->
            <Border Grid.Column="1"
                    Margin="0,0,4,0"
                    Padding="8,3"
                    CornerRadius="10"
                    Background="{DynamicResource Brush.SurfaceAlt}"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsCountdownActive, Converter={StaticResource BoolToVisibilityConverter}}"
                    AutomationProperties.Name="CountdownBadge">
                <TextBlock FontSize="11"
                           Foreground="{DynamicResource Brush.TextSecondary}">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0}s">
                            <Binding Path="CountdownRemainingSeconds"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </Border>

            <Button Grid.Column="2"
                    Style="{StaticResource TitleBarButtonStyle}"
                    Command="{Binding OpenSettingsCommand}"
                    ToolTip="{extensions:Localization MainWindow.SettingsButton.Tooltip}"
                    AutomationProperties.Name="SettingsButton">
                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
            </Button>

            <Button Grid.Column="3"
                    Style="{StaticResource TitleBarButtonStyle}"
                    Click="MinimizeButton_Click"
                    ToolTip="{extensions:Localization MainWindow.MinimizeButton.Tooltip}"
                    AutomationProperties.Name="MinimizeButton">
                <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
            </Button>

            <Button Grid.Column="4"
                    Style="{StaticResource CloseButtonStyle}"
                    Click="CloseButton_Click"
                    ToolTip="{extensions:Localization MainWindow.CloseButton.Tooltip}"
                    AutomationProperties.Name="CloseButton">
                <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
            </Button>
        </Grid>

        <!-- ヘッダー（ロゴ + タイトル。Phase C-0b/C-6で再構成: 新ロゴSMALL（比率6.15）を左、タイトルを右） -->
        <Grid Grid.Row="1"
              Visibility="{Binding VisualSettings.ShowLogo, Converter={StaticResource BoolToVisibilityConverter}}"
              AutomationProperties.Name="HeaderGrid">
            <Grid.Style>
                <Style TargetType="Grid">
                    <!-- ShowTitleBar=falseの場合、右上に常時表示されるハンバーガーメニュー
                         （Grid.RowSpan="6"）と右寄せのタイトルテキストが重なるため余白を追加する. -->
                    <Setter Property="Margin" Value="20,16,20,10"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowTitleBar}" Value="False">
                            <Setter Property="Margin" Value="20,16,54,10"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ロゴ（左、比率6.15の横長バナー。Stretch=UniformでHeightのみ指定し歪みを防止） -->
            <Image Grid.Column="0"
                   Source="/BrowserSelector.Presentation;component/Resources/Images/BrowserSelector_Logo2_SMALL.png"
                   Stretch="Uniform"
                   Height="52"
                   MaxWidth="360"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   AutomationProperties.Name="LogoImage"/>

            <!-- タイトルテキスト（右側、可変幅・狭幅時は省略） -->
            <TextBlock Grid.Column="1"
                       Text="{Binding TitleMessage}"
                       FontSize="16"
                       Foreground="{DynamicResource Brush.TextPrimary}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="10,0,0,0"
                       AutomationProperties.Name="TitleTextBlock"/>
        </Grid>

        <!-- URLが指定されている場合の表示 -->
        <!-- 選択・コピー可能なURL表示。プレーンTextBlockでは選択操作ができないためTextBoxで代替する。 -->
        <TextBox Grid.Row="1"
                   Text="{Binding Url, Mode=OneWay}"
                   IsReadOnly="True"
                   IsReadOnlyCaretVisible="True"
                   BorderThickness="0"
                   Background="Transparent"
                   FontSize="12"
                   HorizontalAlignment="Stretch"
                   HorizontalContentAlignment="Center"
                   TextAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="20,0,20,0"
                   Foreground="{DynamicResource Brush.TextSecondary}"
                   Visibility="{Binding Url, Converter={StaticResource BoolToVisibilityConverter}}"
                   AutomationProperties.Name="UrlDisplayTextBlock"/>

        <!-- URL入力（Phase C-7: エレベーション レベル1 - 背景よりわずかに沈む表現） -->
        <Grid Grid.Row="2"
              Style="{StaticResource TitleBarAwareContentMargin}"
              Visibility="{Binding VisualSettings.ShowUrlInput, Converter={StaticResource BoolToVisibilityConverter}}"
              AutomationProperties.Name="UrlInputGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" AutomationProperties.Name="UrlTextBoxContainer">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 地球アイコン（テキストボックスの左外に配置） -->
                <Image Grid.Column="0"
                        Source="/BrowserSelector.Presentation;component/Resources/Images/Icon_Globe.png"
                        Width="16" Height="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"
                        Opacity="0.6"
                        IsHitTestVisible="False"/>

                <!--
                    プレースホルダーはBackground上のVisualBrushではなく、TextBoxに重ねたTextBlockで表現する。
                    以前はTextBox.Backgroundにローカル値(#FAFAFA)を設定しつつ、同じプロパティに
                    Style.Triggerでプレースホルダー用VisualBrushを設定していたため、
                    WPFの依存関係プロパティ優先順位（ローカル値 > スタイルトリガー）により
                    トリガーが常に無視され、プレースホルダーが表示されない不具合があった（Phase C-0b）。
                -->
                <Grid Grid.Column="1">
                    <TextBox x:Name="UrlTextBox"
                             Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="13"
                             Padding="8,6,10,6"
                             TextWrapping="NoWrap"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Center"
                             Background="{DynamicResource Brush.SurfaceAlt}"
                             Foreground="{DynamicResource Brush.TextPrimary}"
                             BorderBrush="{DynamicResource Brush.Border}"
                             BorderThickness="1"
                             AutomationProperties.Name="UrlInputTextBox"/>

                    <!-- プレースホルダー文言（URL未入力かつ未フォーカス時のみ表示） -->
                    <TextBlock Text="{extensions:Localization MainWindow.UrlPrompt}"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               FontSize="13"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Text, ElementName=UrlTextBox}" Value=""/>
                                            <Condition Binding="{Binding IsKeyboardFocused, ElementName=UrlTextBox}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>

        </Grid>

        <!-- ブラウザ一覧（Phase C-3: UniformGrid + 計算列数） -->
        <Grid Grid.Row="3" Style="{StaticResource TitleBarAwareContentMargin}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="BrowserButtonsScrollViewer"
                          SizeChanged="BrowserButtonsScrollViewer_SizeChanged">
                <ItemsControl x:Name="BrowserItemsControl"
                              ItemsSource="{Binding Browsers}"
                              AlternationCount="35"
                              AutomationProperties.Name="BrowserButtonsContainer">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- Columnsは列数計算の唯一の計算元（TileLayoutHelper.CalculateColumns）から
                                 コードビハインドで設定する。矢印キー移動（C-4）と表示上の列数を一致させるため。 -->
                            <UniformGrid Rows="0"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Tag" Value="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex)}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource BrowserButtonStyle}"
                                    Command="{Binding DataContext.LaunchBrowserCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Content="{Binding DisplayName}"
                                    Tag="{Binding Path=Tag, RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                                    PreviewMouseLeftButtonDown="BrowserButton_PreviewMouseLeftButtonDown"
                                    IsEnabled="{Binding DataContext.Url, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringToBoolConverter}}"
                                    AutomationProperties.Name="{Binding DisplayName, StringFormat={}{0}BrowserButton}">
                                <Button.ToolTip>
                                    <ToolTip>
                                        <TextBlock>
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource BrowserTooltipConverter}">
                                                    <Binding Path="Name"/>
                                                    <Binding Path="ExecutablePath"/>
                                                    <Binding Path="Arguments"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </ToolTip>
                                </Button.ToolTip>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 「起動後に閉じる」チェックボックス（Phase C-5） -->
            <CheckBox Grid.Row="1"
                      Content="{extensions:Localization MainWindow.CloseAfterLaunch}"
                      IsChecked="{Binding CloseAfterLaunch}"
                      HorizontalAlignment="Center"
                      Margin="0,6,0,0"
                      AutomationProperties.Name="CloseAfterLaunchCheckBox"/>

            <!-- テスト用の固定コンテンツ -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding Browsers.Count, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                <TextBlock Text="{extensions:Localization MainWindow.DetectingBrowsers}"
                           FontSize="18"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"
                           Foreground="{Binding VisualSettings.MessageTextColor}"/>
                <TextBlock Text="{extensions:Localization MainWindow.DetectingBrowsersDescription}"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Foreground="{Binding VisualSettings.MessageTextColor}"/>
            </StackPanel>
        </Grid>

        <!-- ステータス -->
        <TextBlock Grid.Row="4"
                   Text="{Binding StatusMessage}"
                   Style="{StaticResource StatusTextStyle}"/>

        <!--
            更新通知バー（Phase H-9）。モーダルは出さず「起動→ブラウザ選択」の最短動線を阻害しない。
            SizeToContent="WidthAndHeight"のためバー表示でウィンドウが伸びる → カウントダウン実行中は
            IsCountdownActive==falseをAND条件にして非表示にする（MultiDataTriggerで判定）。
            ダウンロード中はボタン群を隠しProgressBarを表示する。
        -->
        <Border Grid.Row="5"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource Brush.Accent}"
                Background="{DynamicResource Brush.SurfaceAlt}"
                Padding="12,8"
                AutomationProperties.Name="UpdateNotificationBar">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsUpdateNotificationVisible}" Value="True"/>
                                <Condition Binding="{Binding IsCountdownActive}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- アイコン（Segoe MDL2 更新シンボル） -->
                <TextBlock Grid.Column="0"
                           Text="&#xE895;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="16"
                           Foreground="{DynamicResource Brush.Accent}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <!-- メッセージ + ダウンロード中はProgressBar -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding UpdateNotificationMessage}"
                               Foreground="{DynamicResource Brush.TextPrimary}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               AutomationProperties.Name="UpdateNotificationMessageTextBlock"/>
                    <ProgressBar Value="{Binding UpdateDownloadProgress, Mode=OneWay}"
                                 Minimum="0" Maximum="100"
                                 Height="4" Margin="0,4,0,0"
                                 Visibility="{Binding IsUpdateDownloading, Converter={StaticResource BoolToVisibilityConverter}}"
                                 AutomationProperties.Name="UpdateDownloadProgressBar"/>
                </StackPanel>

                <!-- ボタン群（ダウンロード中は非表示） -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsUpdateDownloading, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                    <Button Content="{extensions:Localization Update.Notification.ReleaseNotes}"
                            Command="{Binding OpenUpdateReleaseNotesCommand}"
                            Padding="8,4" Margin="0,0,6,0"
                            AutomationProperties.Name="UpdateReleaseNotesButton"/>
                    <Button Content="{extensions:Localization Update.Notification.UpdateNow}"
                            Command="{Binding StartUpdateCommand}"
                            Padding="8,4" Margin="0,0,6,0"
                            AutomationProperties.Name="UpdateNowButton"/>
                    <Button Content="{extensions:Localization Update.Notification.NextLaunch}"
                            Command="{Binding DeferUpdateCommand}"
                            Padding="8,4" Margin="0,0,6,0"
                            AutomationProperties.Name="UpdateDeferButton"/>
                    <Button Content="{extensions:Localization Update.Notification.Skip}"
                            Command="{Binding SkipUpdateCommand}"
                            Padding="8,4"
                            AutomationProperties.Name="UpdateSkipButton"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ローディング表示 -->
        <Grid Grid.Row="3"
              Background="{DynamicResource Brush.Scrim}"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
              Panel.ZIndex="1000">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True"
                             Width="100"
                             Height="4"
                             Margin="0,0,0,10"/>
                <TextBlock Text="{extensions:Localization MainWindow.Loading}"
                           Foreground="{DynamicResource Brush.TextOnAccent}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
