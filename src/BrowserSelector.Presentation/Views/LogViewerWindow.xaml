<Window x:Class="BrowserSelector.Presentation.Views.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ログビューアー" Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinHeight="400" MinWidth="600">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ログ内容表示エリア -->
        <TextBox Grid.Row="0" 
                 Text="{Binding LogContent}" 
                 IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="10"
                 Background="Black"
                 Foreground="White"
                 Margin="10"/>

        <!-- ボタンエリア -->
        <StackPanel Grid.Row="1" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="10">
            <Button Command="{Binding RefreshLogsCommand}" 
                    Margin="0,0,10,0" 
                    Padding="15,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="更新" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding CopyToClipboardCommand}" 
                    Margin="0,0,10,0" 
                    Padding="15,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="クリップボードにコピー" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding CloseCommand}" 
                    IsDefault="True" 
                    Padding="15,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="閉じる" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
