    <Window x:Class="BrowserSelector.Presentation.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BrowserSelector.Presentation.Views"
        xmlns:enums="clr-namespace:BrowserSelector.Core.Enums"
        xmlns:converters="clr-namespace:BrowserSelector.Presentation.Converters"
        xmlns:extensions="clr-namespace:BrowserSelector.Presentation.Extensions"
        mc:Ignorable="d"
        Title="{extensions:Localization SettingsWindow.Title}" Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinHeight="500" MinWidth="700"
        AutomationProperties.Name="SettingsWindow">

    <Window.Resources>
        <!--
            Phase E-0: TabItem/GroupBoxはResources/Themes/Controls.xaml（Phase C-0のデザイントークン基盤）の
            既定スタイル（トークンDynamicResource参照）をそのまま使う。ここではレイアウト値（Padding等）のみ上書きする。
        -->
        <Style x:Key="TabItemStyle" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <Style x:Key="GroupBoxStyle" TargetType="GroupBox" BasedOn="{StaticResource {x:Type GroupBox}}">
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!--
            設定行の共通レイアウト（Phase E-0）: ラベルとコントロールを同一行にまとめ、
            チェックボックスがラベルから遠い右端に孤立して見える問題を是正する。
            行間にVerticalAlignment.Centerを揃え、視覚的な対応関係を明確にする。
        -->
        <Style x:Key="SettingRowStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!--
            主ボタン（OK）スタイル（Phase E-0）: アクセントカラーで塗り、他のボタンと視覚的な主従を明確にする。
            破壊的な操作（リセット）は逆に色を付けず、ボタン列の左端へ離して配置することで誤操作を防ぐ。
        -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnAccent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- コンバーター -->
        <converters:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
        <converters:GradientDirectionToIndexConverter x:Key="GradientDirectionToIndexConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- メインコンテンツ -->
        <TabControl Grid.Row="0" Margin="10"
                    AutomationProperties.Name="SettingsTabControl">
            
            <!-- 一般設定タブ -->
            <TabItem Style="{StaticResource TabItemStyle}"
                     AutomationProperties.Name="GeneralTab">
                <TabItem.Header>
                    <!-- Phase E-0: 旧Icon_General.pngはスマホ型のアイコンで内容と無関係だったため、
                         意味の一致するSegoe MDL2の歯車グリフに差し替え -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                   Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{extensions:Localization SettingsWindow.General}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        
                        <!-- アプリケーション設定 -->
                        <GroupBox Header="{extensions:Localization Settings.App.ApplicationSettings}" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>

                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{extensions:Localization Settings.App.CloseAfterLaunch}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding AppSettings.CloseAfterUrlRuleMatch}" HorizontalAlignment="Left" Margin="8,5,5,5"/>
                                </Grid>

                                <!-- カウントダウン自動起動秒数（Phase E-1） -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{extensions:Localization Settings.App.CountdownDelaySeconds}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding AppSettings.DefaultDelay}"
                                             Margin="8,5,5,5" HorizontalAlignment="Left"
                                             ToolTip="{extensions:Localization Settings.App.CountdownDelaySecondsTooltip}"
                                             AutomationProperties.Name="CountdownDelayTextBox"/>
                                </Grid>

                                <!-- トレイ常駐（Phase E-1） -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{extensions:Localization Settings.App.AlwaysResidentInTray}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding AppSettings.AlwaysResidentInTray}" HorizontalAlignment="Left" Margin="8,5,5,5"
                                              AutomationProperties.Name="AlwaysResidentInTrayCheckBox"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!-- 既定ブラウザ設定 -->
                        <GroupBox Header="{extensions:Localization Settings.App.DefaultBrowserSettings}" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{extensions:Localization Settings.App.DefaultBrowserStatus}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{extensions:Localization Settings.App.DefaultBrowserYes}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource Brush.Accent}"
                                                   Margin="4,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsDefaultBrowser, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <TextBlock Text="{extensions:Localization Settings.App.DefaultBrowserNo}"
                                                   Margin="4,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsDefaultBrowser, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="{extensions:Localization Settings.App.SetAsDefaultBrowser}"
                                            Command="{Binding OpenDefaultAppsSettingsCommand}"
                                            Padding="10,5"
                                            AutomationProperties.Name="SetAsDefaultBrowserButton"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!-- 言語設定 -->
                        <GroupBox Header="{extensions:Localization Settings.App.LanguageSettings}" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{extensions:Localization Settings.App.Language}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <ComboBox SelectedItem="{Binding SelectedLanguage}"
                                                  ItemsSource="{Binding AvailableLanguages}"
                                                  DisplayMemberPath="DisplayName"
                                                  VerticalAlignment="Center"
                                                  MinWidth="150"/>
                                        <Button Content="{extensions:Localization Settings.App.LanguageManagement}" 
                                                Click="LanguageManagementButton_Click"
                                                Margin="10,0,0,0"
                                                Padding="0,0"
                                                MinWidth="90"
                                                Height="30"
                                                ToolTip="{extensions:Localization Settings.App.LanguageManagement}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </GroupBox>



                        <!-- アップデート設定 -->
                        <GroupBox Header="{extensions:Localization Settings.App.UpdateSettings}" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{extensions:Localization Settings.App.AutoUpdateCheck}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding AppSettings.CheckForUpdates}" HorizontalAlignment="Left" Margin="8,5,5,5"/>
                                </Grid>
                                
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{extensions:Localization Settings.App.UpdateCheckInterval}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding AppSettings.UpdateCheckInterval}"
                                             VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>

                                <!-- プレリリースを含める（Phase H-8） -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{extensions:Localization Settings.App.IncludePrereleases}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding AppSettings.IncludePrereleases}" HorizontalAlignment="Left" Margin="8,5,5,5"
                                              AutomationProperties.Name="IncludePrereleasesCheckBox"/>
                                </Grid>

                                <!-- 最終チェック日時（Phase H-8） -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{extensions:Localization Settings.App.LastUpdateCheck}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LastUpdateCheckDisplay}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               AutomationProperties.Name="LastUpdateCheckTextBlock"/>
                                </Grid>

                                <!-- 今すぐ確認（Phase H-8） -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding UpdateCheckStatusMessage}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               TextTrimming="CharacterEllipsis"
                                               AutomationProperties.Name="UpdateCheckStatusTextBlock"/>
                                    <Button Grid.Column="1" Content="{extensions:Localization Settings.App.CheckNow}"
                                            Command="{Binding CheckForUpdatesNowCommand}"
                                            Padding="10,5" Margin="10,0,0,0"
                                            AutomationProperties.Name="CheckForUpdatesNowButton"/>
                                </Grid>

                                <!-- 更新を適用（今すぐ確認で更新が見つかっている間のみ表示） -->
                                <Grid Style="{StaticResource SettingRowStyle}"
                                      Visibility="{Binding HasFoundUpdate, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar Value="{Binding ApplyUpdateProgress, Mode=OneWay}"
                                                 Minimum="0" Maximum="100"
                                                 Height="4" VerticalAlignment="Center"
                                                 Visibility="{Binding IsApplyingUpdate, Converter={StaticResource BoolToVisibilityConverter}}"
                                                 AutomationProperties.Name="ApplyUpdateProgressBar"/>
                                    <Button Grid.Column="1" Content="{extensions:Localization Settings.App.ApplyUpdate}"
                                            Command="{Binding ApplyUpdateNowCommand}"
                                            Padding="10,5" Margin="10,0,0,0"
                                            AutomationProperties.Name="ApplyUpdateNowButton"/>
                                </Grid>

                                <!-- スキップを解除（Phase H-8、SkippedUpdateVersionが設定されているときのみ表示） -->
                                <Grid Style="{StaticResource SettingRowStyle}"
                                      Visibility="{Binding HasSkippedUpdateVersion, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding AppSettings.SkippedUpdateVersion, StringFormat='v{0}'}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.TextSecondary}"/>
                                    <Button Grid.Column="1" Content="{extensions:Localization Settings.App.ClearSkippedVersion}"
                                            Command="{Binding ClearSkippedVersionCommand}"
                                            Padding="10,5" Margin="10,0,0,0"
                                            AutomationProperties.Name="ClearSkippedVersionButton"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!--
                            バージョン情報（About、Phase E-2）。新規タブは作らず「一般」タブ最下部に配置する。
                            リンクはProcess.Start(UseShellExecute)ではなくIExternalLinkService経由で開く。
                            既定ブラウザがBrowserSelector自身の場合の自己再帰起動を防ぐため。
                        -->
                        <GroupBox Header="{extensions:Localization Settings.About.Title}" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <TextBlock Text="{Binding AppNameVersionDisplay}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"
                                           AutomationProperties.Name="AppNameVersionTextBlock"/>

                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{extensions:Localization Settings.About.Provider}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{extensions:Localization Settings.About.ProviderValue}" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{extensions:Localization Settings.About.License}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{extensions:Localization Settings.About.LicenseValue}" VerticalAlignment="Center"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="{extensions:Localization Settings.About.Repository}"
                                            Command="{Binding OpenRepositoryCommand}"
                                            Padding="10,5" Margin="0,0,10,0"
                                            AutomationProperties.Name="OpenRepositoryButton"/>
                                    <Button Content="{extensions:Localization Settings.About.Issues}"
                                            Command="{Binding OpenIssuesCommand}"
                                            Padding="10,5" Margin="0,0,10,0"
                                            AutomationProperties.Name="OpenIssuesButton"/>
                                    <Button Content="{extensions:Localization Settings.About.Releases}"
                                            Command="{Binding OpenReleasesCommand}"
                                            Padding="10,5"
                                            AutomationProperties.Name="OpenReleasesButton"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 表示設定タブ -->
            <TabItem Style="{StaticResource TabItemStyle}"
                     AutomationProperties.Name="DisplayTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/BrowserSelector.Presentation;component/Resources/Images/Icon_Display.png" 
                               Width="18" Height="18" 
                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{extensions:Localization SettingsWindow.Display}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        
                        <!-- 背景設定 -->
                        <GroupBox Header="{extensions:Localization Settings.Display.BackgroundSettings}" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <!-- 背景色 -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{extensions:Localization Settings.Display.BackgroundColor}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="{extensions:Localization Common.SelectColor}" Padding="10,5"
                                            Command="{Binding SelectBackgroundColorCommand}"/>
                                    <!-- 現在色を可視化 -->
                                    <Border Grid.Column="2" Width="24" Height="24" Margin="10,0,0,0"
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                            Background="{Binding VisualSettings.BackgroundColor, Converter={StaticResource ColorToBrushConverter}}" />
                                </Grid>

                                <!-- 背景グラデーション -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{extensions:Localization Settings.Display.BackgroundGradient}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding VisualSettings.UseBackgroundGradient}" HorizontalAlignment="Left" Margin="8,5,5,5"/>
                                </Grid>

                                <!-- グラデーション開始色 -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{extensions:Localization Settings.Display.GradientStartColor}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="{extensions:Localization Common.SelectColor}" Padding="10,5"
                                            Command="{Binding SelectGradientStartColorCommand}"/>
                                    <!-- 現在色を可視化 -->
                                    <Border Grid.Column="2" Width="24" Height="24" Margin="10,0,0,0"
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                            Background="{Binding VisualSettings.GradientStartColor, Converter={StaticResource ColorToBrushConverter}}" />
                                </Grid>

                                <!-- グラデーション終了色 -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{extensions:Localization Settings.Display.GradientEndColor}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="{extensions:Localization Common.SelectColor}" Padding="10,5"
                                            Command="{Binding SelectGradientEndColorCommand}"/>
                                    <!-- 現在色を可視化 -->
                                    <Border Grid.Column="2" Width="24" Height="24" Margin="10,0,0,0"
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                            Background="{Binding VisualSettings.GradientEndColor, Converter={StaticResource ColorToBrushConverter}}" />
                                </Grid>

                                <!-- グラデーション方向 -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{extensions:Localization Settings.Display.GradientDirection}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" 
                                              SelectedIndex="{Binding VisualSettings.GradientDirection, Converter={StaticResource GradientDirectionToIndexConverter}}"
                                              VerticalAlignment="Center"
                                              IsEnabled="{Binding VisualSettings.UseBackgroundGradient}"
                                              SelectionChanged="GradientDirectionComboBox_SelectionChanged">
                                        <ComboBoxItem Content="{extensions:Localization Common.Vertical}"/>
                                        <ComboBoxItem Content="{extensions:Localization Common.Horizontal}"/>
                                        <ComboBoxItem Content="{extensions:Localization Common.Diagonal}"/>
                                    </ComboBox>
                                </Grid>


                            </StackPanel>
                        </GroupBox>

                        <!-- ウィンドウ設定 -->
                        <GroupBox Header="{extensions:Localization Settings.Display.WindowSettings}" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <!-- 初期起動サイズ -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{extensions:Localization Settings.Display.InitialSize}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding VisualSettings.InitialWindowWidth}"
                                             VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Grid.Column="2" Text="{extensions:Localization Common.Multiply}" VerticalAlignment="Center"
                                               HorizontalAlignment="Center"/>
                                    <TextBox Grid.Column="3" Text="{Binding VisualSettings.InitialWindowHeight}"
                                             VerticalAlignment="Center"/>
                                </Grid>

                                <!-- 現在のウィンドウサイズを取得 -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{extensions:Localization Settings.Display.CaptureCurrentWindowSizeDescription}"
                                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <Button Grid.Column="1"
                                            Content="{extensions:Localization Settings.Display.CaptureCurrentWindowSize}"
                                            Command="{Binding CaptureCurrentWindowSizeCommand}"
                                            Padding="10,5"
                                            AutomationProperties.Name="CaptureCurrentWindowSizeButton"/>
                                </Grid>

                                <!-- ロゴ表示 -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{extensions:Localization Settings.Display.ShowLogo}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding VisualSettings.ShowLogo}" HorizontalAlignment="Left" Margin="8,5,5,5"/>
                                </Grid>
                                
                                <!-- URL入力表示 -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{extensions:Localization Settings.Display.ShowUrlInput}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding VisualSettings.ShowUrlInput}" HorizontalAlignment="Left" Margin="8,5,5,5"/>
                                </Grid>
                                
                            </StackPanel>
                        </GroupBox>

                        <!-- ブラウザボタン設定 -->
                        <GroupBox Header="{extensions:Localization Settings.Display.BrowserButtonSettings}" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <!-- ボタンサイズ -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{extensions:Localization Settings.Display.ButtonSize}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding VisualSettings.BrowserButtonWidth}" 
                                             VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Grid.Column="2" Text="{extensions:Localization Common.Multiply}" VerticalAlignment="Center" 
                                               HorizontalAlignment="Center"/>
                                    <TextBox Grid.Column="3" Text="{Binding VisualSettings.BrowserButtonHeight}" 
                                             VerticalAlignment="Center"/>
                                </Grid>

                                <!-- ボタン背景色 -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{extensions:Localization Settings.Display.ButtonBackgroundColor}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="{extensions:Localization Common.SelectColor}" Padding="10,5"
                                            Command="{Binding SelectBrowserButtonBackgroundColorCommand}"/>
                                    <!-- 現在色を可視化 -->
                                    <Border Grid.Column="2" Width="24" Height="24" Margin="10,0,0,0"
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                            Background="{Binding VisualSettings.BrowserButtonBackgroundColor, Converter={StaticResource ColorToBrushConverter}}" />
                                </Grid>

                                <!-- ボタンテキスト色 -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{extensions:Localization Settings.Display.ButtonTextColor}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="{extensions:Localization Common.SelectColor}" Padding="10,5"
                                            Command="{Binding SelectBrowserButtonForegroundColorCommand}"/>
                                    <!-- 現在色を可視化 -->
                                    <Border Grid.Column="2" Width="24" Height="24" Margin="10,0,0,0"
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                            Background="{Binding VisualSettings.BrowserButtonForegroundColor, Converter={StaticResource ColorToBrushConverter}}" />
                                </Grid>

                                <!-- ボタン背景透明化 -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{extensions:Localization Settings.Display.ButtonTransparency}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="0.1" Maximum="1.0" 
                                            Value="{Binding VisualSettings.BrowserButtonOpacity}"
                                            VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding VisualSettings.BrowserButtonOpacity, StringFormat={}{0:P0}}" 
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Grid>

                                <!-- ボタン角丸半径 -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{extensions:Localization Settings.Display.ButtonCornerRadius}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="20" 
                                            Value="{Binding VisualSettings.BrowserButtonCornerRadius}"
                                            VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding VisualSettings.BrowserButtonCornerRadius, StringFormat={}{0:F0}px}"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Grid>

                                <!-- タイルの立体表現 -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{extensions:Localization Settings.Display.TileElevationStyle}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" Margin="8,5,5,5"
                                              ItemsSource="{Binding AvailableTileElevationStyles}"
                                              SelectedItem="{Binding VisualSettings.TileElevationStyle}"
                                              AutomationProperties.Name="TileElevationStyleComboBox"/>
                                </Grid>

                                <!-- ブラウザ名表示 -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{extensions:Localization Settings.Display.ShowBrowserName}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding VisualSettings.ShowBrowserName}" HorizontalAlignment="Left" Margin="8,5,5,5"/>
                                </Grid>

                                <!-- アイコンサイズ -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{extensions:Localization Settings.Display.IconSize}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="16" Maximum="64" 
                                            Value="{Binding VisualSettings.BrowserIconSize}"
                                            VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding VisualSettings.BrowserIconSize, StringFormat={}{0:F0}px}" 
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Grid>
                                
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 外観タブ（Phase E-1: バックドロップ方式・不透明度・角丸・タイトルバー・常に最前面・テーマ） -->
            <TabItem Style="{StaticResource TabItemStyle}"
                     AutomationProperties.Name="AppearanceTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                   Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{extensions:Localization SettingsWindow.Appearance}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">

                        <!-- ガラス効果・バックドロップ -->
                        <GroupBox Header="{extensions:Localization Settings.Appearance.GlassSettings}" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{extensions:Localization Settings.Appearance.EnableGlassEffect}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding AppSettings.EnableGlassEffect}" HorizontalAlignment="Left" Margin="8,5,5,5"
                                              AutomationProperties.Name="EnableGlassEffectCheckBox"/>
                                </Grid>

                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{extensions:Localization Settings.Appearance.BackdropMode}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" Margin="8,5,5,5"
                                              ItemsSource="{Binding AvailableBackdropModes}"
                                              SelectedItem="{Binding AppSettings.BackdropMode}"
                                              AutomationProperties.Name="BackdropModeComboBox"/>
                                </Grid>

                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{extensions:Localization Settings.Appearance.WindowOpacity}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="0.3" Maximum="1.0"
                                            Value="{Binding AppSettings.WindowOpacity}"
                                            VerticalAlignment="Center" Margin="0,0,5,0"
                                            AutomationProperties.Name="WindowOpacitySlider"/>
                                    <TextBlock Grid.Column="2" Text="{Binding AppSettings.WindowOpacity, StringFormat={}{0:P0}}"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Grid>

                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{extensions:Localization Settings.Appearance.WindowCornerRadius}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="20"
                                            Value="{Binding AppSettings.WindowCornerRadius}"
                                            VerticalAlignment="Center" Margin="0,0,5,0"
                                            AutomationProperties.Name="WindowCornerRadiusSlider"/>
                                    <TextBlock Grid.Column="2" Text="{Binding AppSettings.WindowCornerRadius, StringFormat={}{0:F0}px}"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Grid>

                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{extensions:Localization Settings.Appearance.EnableAnimations}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding AppSettings.EnableAnimations}" HorizontalAlignment="Left" Margin="8,5,5,5"
                                              AutomationProperties.Name="EnableAnimationsCheckBox"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!-- ウィンドウ -->
                        <GroupBox Header="{extensions:Localization Settings.Appearance.WindowSettings}" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{extensions:Localization Settings.Appearance.ShowTitleBar}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding AppSettings.ShowTitleBar}" HorizontalAlignment="Left" Margin="8,5,5,5"
                                              AutomationProperties.Name="ShowTitleBarCheckBox"/>
                                </Grid>

                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{extensions:Localization Settings.Appearance.AlwaysOnTop}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding AppSettings.AlwaysOnTop}" HorizontalAlignment="Left" Margin="8,5,5,5"
                                              AutomationProperties.Name="AlwaysOnTopCheckBox"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!-- テーマ -->
                        <GroupBox Header="{extensions:Localization Settings.Appearance.ThemeSettings}" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{extensions:Localization Settings.Appearance.Theme}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" Margin="8,5,5,5"
                                              ItemsSource="{Binding AvailableThemeModes}"
                                              SelectedItem="{Binding AppSettings.ThemeMode}"
                                              AutomationProperties.Name="ThemeModeComboBox"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ブラウザ設定タブ -->
            <TabItem Style="{StaticResource TabItemStyle}"
                     AutomationProperties.Name="BrowserTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/BrowserSelector.Presentation;component/Resources/Images/Icon_Browser.png" 
                               Width="18" Height="18" 
                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{extensions:Localization SettingsWindow.Browser}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <!--
                    Phase E-0: 旧実装はScrollViewer+StackPanelでGroupBox/ListBoxに固定Height（400/250）を指定しており、
                    ウィンドウを縦に広げてもブラウザ一覧の表示領域が伸びなかった。
                    Gridの*行でGroupBoxが残り空間いっぱいに広がるようにし、内部もStackPanelではなくGrid（*行）で
                    ListBox自身がスクロールする構成に変更した。
                -->
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <GroupBox Header="{extensions:Localization Settings.Browser.BrowserManagement}" Style="{StaticResource GroupBoxStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{extensions:Localization Settings.Browser.DetectedBrowsers}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <ListBox Grid.Row="1" ItemsSource="{Binding DetectedBrowsers}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding DisplayOrder}" 
                                                           FontSize="10" Foreground="Gray" 
                                                           VerticalAlignment="Center" Margin="0,0,5,0" Width="20"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0">
                                                    <Button Content="↑" Padding="0,0" FontSize="12" Width="30" Height="30"
                                                            FontFamily="Segoe UI Symbol" FontWeight="Bold"
                                                            Command="{Binding DataContext.MoveBrowserUpCommand, 
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="↓" Padding="0,0" FontSize="12" Width="30" Height="30"
                                                            FontFamily="Segoe UI Symbol" FontWeight="Bold"
                                                            Command="{Binding DataContext.MoveBrowserDownCommand, 
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,5,0">
                                                    <TextBlock Text="{Binding Name}" 
                                                               VerticalAlignment="Center" FontSize="12"/>
                                                    <TextBlock Text="{Binding ExecutablePath}" 
                                                               FontSize="9" Foreground="Gray" 
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Button Grid.Column="3" Content="{extensions:Localization Common.Edit}" Padding="1,1" FontSize="12"  Width="80" Height="30"
                                                        Margin="2,0,0,0" Command="{Binding DataContext.EditBrowserCommand, 
                                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Grid.Column="4" Content="{extensions:Localization Common.Delete}" Padding="1,1" FontSize="12" Width="80" Height="30"
                                                        Margin="2,0,0,0" Command="{Binding DataContext.RemoveBrowserCommand, 
                                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Command="{Binding RefreshBrowsersCommand}"
                                        Margin="0,0,10,0" Padding="10,5"
                                        AutomationProperties.Name="RefreshBrowsersButton">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Image Source="/BrowserSelector.Presentation;component/Resources/Images/Icon_Refresh.png"
                                               Width="18" Height="18"
                                               Margin="8,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{extensions:Localization Settings.Browser.RedetectBrowsers}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding AddBrowserCommand}"
                                        Margin="0,0,10,0" Padding="10,5"
                                        AutomationProperties.Name="AddBrowserButton">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Image Source="/BrowserSelector.Presentation;component/Resources/Images/Icon_Add.png"
                                               Width="18" Height="19"
                                               Margin="8,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{extensions:Localization Common.Add}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- URLルール設定タブ -->
            <TabItem Style="{StaticResource TabItemStyle}"
                     AutomationProperties.Name="UrlRulesTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/BrowserSelector.Presentation;component/Resources/Images/Icon_Rules.png" 
                               Width="18" Height="18" 
                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{extensions:Localization Settings.UrlRules.Title}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        
                        <!-- URLルール一覧 -->
                        <GroupBox Header="{extensions:Localization Settings.UrlRules.UrlRuleList}" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <TextBlock Text="{extensions:Localization Settings.UrlRules.ConfiguredRules}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <ListBox Height="200" ItemsSource="{Binding UrlRules}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" 
                                                          IsEnabled="False"
                                                          Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" 
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" FontSize="10" Foreground="Gray" 
                                                           Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} ({1}:{2})">
                                                            <Binding Path="Pattern"/>
                                                            <Binding Source="{extensions:Localization Dialog.UrlRuleEdit.Priority}"/>
                                                            <Binding Path="Priority"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <Button Grid.Column="3" Content="{extensions:Localization Common.Edit}" Padding="5,2" 
                                                        Margin="10,0,0,0" Command="{Binding DataContext.EditUrlRuleCommand, 
                                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Grid.Column="4" Content="{extensions:Localization Common.Delete}" Padding="5,2" 
                                                        Margin="10,0,0,0" Command="{Binding DataContext.RemoveUrlRuleCommand, 
                                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Command="{Binding AddUrlRuleCommand}" 
                                            Margin="0,0,10,0" Padding="10,5"
                                            AutomationProperties.Name="AddUrlRuleButton">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Image Source="/BrowserSelector.Presentation;component/Resources/Images/Icon_Add.png" 
                                                   Width="18" Height="19" 
                                                   Margin="8,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{extensions:Localization Settings.UrlRules.AddRule}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding RefreshUrlRulesCommand}" 
                                            Margin="0,0,10,0" Padding="10,5"
                                            AutomationProperties.Name="RefreshUrlRulesButton">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Image Source="/BrowserSelector.Presentation;component/Resources/Images/Icon_Refresh.png" 
                                                   Width="18" Height="18" 
                                                   Margin="8,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{extensions:Localization Settings.UrlRules.RefreshRules}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- ルールテスト -->
                        <GroupBox Header="{extensions:Localization Settings.UrlRules.RuleTest}" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{extensions:Localization Settings.UrlRules.TestUrl}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Command="{Binding TestUrlRuleCommand}" 
                                            Content="{extensions:Localization Common.Test}" Padding="10,5"
                                            AutomationProperties.Name="TestUrlRuleButton"/>
                                </Grid>
                                
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding TestUrl}" 
                                             VerticalAlignment="Center" 
                                             ToolTip="{extensions:Localization Settings.UrlRules.TestUrlTooltip}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TestResult}" 
                                               VerticalAlignment="Center" 
                                               Margin="10,0,0,0" 
                                               Foreground="{Binding TestResultColor}"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- アクセシビリティ設定タブ（Phase E-1で復活。バインド先の設定は既に存在し永続化もされている） -->
            <TabItem Style="{StaticResource TabItemStyle}"
                     AutomationProperties.Name="AccessibilityTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/BrowserSelector.Presentation;component/Resources/Images/Icon_Accessibility.png"
                               Width="18" Height="18"
                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{extensions:Localization Settings.Accessibility.Title}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        
                        <!-- フォーカス設定 -->
                        <GroupBox Header="{extensions:Localization Settings.Accessibility.FocusSettings}" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{extensions:Localization Settings.Accessibility.EnableFocusIndicator}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding ShowFocusIndicator}" HorizontalAlignment="Left" Margin="8,5,5,5"/>
                                </Grid>
                                
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{extensions:Localization Settings.Accessibility.FocusThickness}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Value="{Binding FocusThickness}" 
                                            Minimum="1" Maximum="5" 
                                            TickFrequency="1" IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!-- キーボード設定 -->
                        <GroupBox Header="{extensions:Localization Settings.Accessibility.KeyboardSettings}" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{extensions:Localization Settings.Accessibility.EnableKeyboardNavigation}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding EnableKeyboardNavigation}" HorizontalAlignment="Left" Margin="8,5,5,5"/>
                                </Grid>
                                
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{extensions:Localization Settings.Accessibility.EnableShortcuts}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding EnableShortcuts}" HorizontalAlignment="Left" Margin="8,5,5,5"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!-- スクリーンリーダー設定 -->
                        <GroupBox Header="{extensions:Localization Settings.Accessibility.ScreenReaderSettings}" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{extensions:Localization Settings.Accessibility.EnableScreenReaderSupport}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding EnableScreenReaderSupport}" HorizontalAlignment="Left" Margin="8,5,5,5"/>
                                </Grid>
                                
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{extensions:Localization Settings.Accessibility.ProvideDetailedDescriptions}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding ProvideDetailedDescriptions}" HorizontalAlignment="Left" Margin="8,5,5,5"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ログ設定タブ -->
            <TabItem Style="{StaticResource TabItemStyle}"
                     AutomationProperties.Name="LogTab">
                <TabItem.Header>
                    <!-- Phase E-0: 旧Icon_Log.pngは△（警告記号）で内容と無関係だったため、
                         意味の一致するSegoe MDL2の文書グリフに差し替え -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                   Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{extensions:Localization Settings.Logging.Title}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        
                        <!-- 基本ログ設定 -->
                        <GroupBox Header="{extensions:Localization Settings.Logging.BasicLogSettings}" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{extensions:Localization Settings.Logging.EnableLogging}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding LogSettings.EnableLogging}" HorizontalAlignment="Left" Margin="8,5,5,5"/>
                                </Grid>
                                
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{extensions:Localization Settings.Logging.LogLevel}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" SelectedItem="{Binding SelectedLogLevel}"
                                              ItemsSource="{Binding AvailableLogLevels}"
                                              DisplayMemberPath="DisplayName"
                                              VerticalAlignment="Center"/>
                                </Grid>
                                
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{extensions:Localization Settings.Logging.EnableConsoleLogging}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding LogSettings.EnableConsoleLogging}" HorizontalAlignment="Left" Margin="8,5,5,5"/>
                                </Grid>
                                
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{extensions:Localization Settings.Logging.EnableFileLogging}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding LogSettings.EnableFileLogging}" HorizontalAlignment="Left" Margin="8,5,5,5"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!-- ファイルログ設定 -->
                        <GroupBox Header="{extensions:Localization Settings.Logging.FileLogSettings}" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{extensions:Localization Settings.Logging.LogOutputFolder}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="{extensions:Localization Common.SelectFolder}" Padding="10,5"
                                            Command="{Binding SelectLogFolderCommand}"/>
                                </Grid>
                                
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{extensions:Localization Settings.Logging.MaxLogFileSize}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding LogSettings.MaxLogFileSize}" 
                                             VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                                
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{extensions:Localization Settings.Logging.LogRetentionDays}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding LogSettings.LogRetentionDays}" 
                                             VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                                
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{extensions:Localization Settings.Logging.LogFilePrefix}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding LogSettings.LogFilePrefix}" 
                                             Width="150" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!-- ログ管理 -->
                        <GroupBox Header="{extensions:Localization Settings.Logging.LogManagement}" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{extensions:Localization Settings.Logging.CurrentLogFile}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CurrentLogFilePath}" 
                                               Foreground="Gray" FontSize="10" VerticalAlignment="Center"/>
                                </Grid>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Command="{Binding ViewLogsCommand}" Margin="0,0,10,0" Padding="10,5">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Image Source="/BrowserSelector.Presentation;component/Resources/Images/Icon_View.png" 
                                                   Width="18" Height="18" 
                                                   Margin="8,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{extensions:Localization Settings.Logging.ViewLogs}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding ClearLogsCommand}" Margin="0,0,10,0" Padding="10,5">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Image Source="/BrowserSelector.Presentation;component/Resources/Images/Icon_Clear.png" 
                                                   Width="18" Height="18" 
                                                   Margin="8,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{extensions:Localization Settings.Logging.ClearLogs}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding CleanupOldLogsCommand}" Padding="10,5">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Image Source="/BrowserSelector.Presentation;component/Resources/Images/Icon_Cleanup.png" 
                                                   Width="18" Height="18" 
                                                   Margin="8,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{extensions:Localization Settings.Logging.CleanupOldLogs}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!--
            ボタンエリア（Phase E-0）: 破壊的な「リセット」は左端へ分離して誤操作を防ぎ、
            主ボタンの「OK」はアクセントカラーで塗って主従を明確にする。
            インポート/エクスポートはOK/キャンセルと同じ右側グループだが副次操作として通常スタイルのまま。
        -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Command="{Binding ResetSettingsCommand}"
                    Padding="15,8"
                    AutomationProperties.Name="ResetSettingsButton">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Source="/BrowserSelector.Presentation;component/Resources/Images/Icon_Reset.png"
                           Width="18" Height="18"
                           Margin="8,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{extensions:Localization Common.Reset}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding ImportSettingsCommand}"
                        Margin="0,0,10,0" Padding="15,8"
                        AutomationProperties.Name="ImportSettingsButton">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Image Source="/BrowserSelector.Presentation;component/Resources/Images/Icon_Import.png"
                               Width="18" Height="18"
                               Margin="8,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{extensions:Localization Common.Import}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ExportSettingsCommand}"
                        Margin="0,0,10,0" Padding="15,8"
                        AutomationProperties.Name="ExportSettingsButton">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Image Source="/BrowserSelector.Presentation;component/Resources/Images/Icon_Export.png"
                               Width="18" Height="18"
                               Margin="8,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{extensions:Localization Common.Export}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding SaveSettingsCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True" Padding="15,8" Margin="0,0,10,0"
                        AutomationProperties.Name="SaveSettingsButton">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Image Source="/BrowserSelector.Presentation;component/Resources/Images/Icon_Check.png"
                               Width="18" Height="18"
                               Margin="8,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{extensions:Localization Common.OK}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextOnAccent}"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding CancelCommand}"
                        IsCancel="True" Padding="15,8"
                        AutomationProperties.Name="CancelSettingsButton">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Image Source="/BrowserSelector.Presentation;component/Resources/Images/Icon_Close.png"
                               Width="18" Height="18"
                               Margin="8,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{extensions:Localization Common.Cancel}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
