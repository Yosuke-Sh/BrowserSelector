<Window x:Class="BrowserSelector.Presentation.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BrowserSelector.Presentation.Views"
        xmlns:controls="clr-namespace:BrowserSelector.Presentation.Controls"
        mc:Ignorable="d"
        Title="設定" Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinHeight="500" MinWidth="700">

    <Window.Resources>
        <Style x:Key="TabItemStyle" TargetType="TabItem">
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        
        <Style x:Key="GroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        
        <Style x:Key="SettingRowStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,5,0,5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- メインコンテンツ -->
        <TabControl Grid.Row="0" Margin="10">
            
            <!-- 一般設定タブ -->
            <TabItem Header="一般" Style="{StaticResource TabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        
                        <!-- 起動設定 -->
                        <GroupBox Header="起動設定" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="最小化で起動" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding AppSettings.StartMinimized}"/>
                                </Grid>
                                
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="システムトレイで起動" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding AppSettings.StartInSystemTray}"/>
                                </Grid>
                                
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="起動遅延（秒）" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding AppSettings.StartupDelay}" 
                                             VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!-- 言語設定 -->
                        <GroupBox Header="言語設定" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="言語" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" SelectedItem="{Binding SelectedLanguage}"
                                              ItemsSource="{Binding AvailableLanguages}"
                                              DisplayMemberPath="DisplayName"
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!-- ログ設定 -->
                        <GroupBox Header="ログ設定" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ログを有効にする" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding AppSettings.EnableLogging}"/>
                                </Grid>
                                
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ログレベル" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" SelectedItem="{Binding SelectedLogLevel}"
                                              ItemsSource="{Binding LogLevels}"
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!-- アップデート設定 -->
                        <GroupBox Header="アップデート設定" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="自動更新チェック" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding AppSettings.CheckForUpdates}"/>
                                </Grid>
                                
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="チェック間隔（時間）" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding AppSettings.UpdateCheckInterval}" 
                                             VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 表示設定タブ -->
            <TabItem Header="表示" Style="{StaticResource TabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        
                        <!-- 透明化設定 -->
                        <GroupBox Header="透明化設定" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="透明度" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Value="{Binding VisualSettings.Opacity}" 
                                            Minimum="0.01" Maximum="1.0" 
                                            TickFrequency="0.1" IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center"/>
                                </Grid>
                                
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="カスタム透明化色を使用" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding VisualSettings.UseCustomTransparencyColor}"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!-- 角の丸み設定 -->
                        <GroupBox Header="角の丸み設定" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="角の丸み" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Value="{Binding VisualSettings.CornerRadius}" 
                                            Minimum="0" Maximum="50" 
                                            TickFrequency="5" IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!-- 背景設定 -->
                        <GroupBox Header="背景設定" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="カスタム背景色を使用" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding VisualSettings.UseCustomBackgroundColor}"/>
                                </Grid>
                                
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="背景グラデーションを使用" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding VisualSettings.UseBackgroundGradient}"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!-- タイトルバー設定 -->
                        <GroupBox Header="タイトルバー設定" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="タイトルバーを表示" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding VisualSettings.ShowTitleBar}"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ブラウザ設定タブ -->
            <TabItem Header="ブラウザ" Style="{StaticResource TabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        
                        <!-- URL処理設定 -->
                        <GroupBox Header="URL処理設定" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="短縮URLを展開" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding AppSettings.ExpandShortenedUrls}"/>
                                </Grid>
                                
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ユーザーエージェント" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding AppSettings.UserAgent}" 
                                             VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!-- プロトコル設定 -->
                        <GroupBox Header="プロトコル設定" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="プロトコルを登録" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding AppSettings.RegisterProtocol}"/>
                                </Grid>
                                
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="カスタムプロトコル" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding AppSettings.CustomProtocol}" 
                                             VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!-- ブラウザ管理 -->
                        <GroupBox Header="ブラウザ管理" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <TextBlock Text="検出されたブラウザ:" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <ListBox Height="200" ItemsSource="{Binding DetectedBrowsers}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" 
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding ExecutablePath}" 
                                                           FontSize="10" Foreground="Gray" 
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="ブラウザを再検出" Command="{Binding RefreshBrowsersCommand}" 
                                            Margin="0,0,10,0" Padding="10,5"/>
                                    <Button Content="ブラウザを追加" Command="{Binding AddBrowserCommand}" 
                                            Margin="0,0,10,0" Padding="10,5"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- アクセシビリティ設定タブ -->
            <TabItem Header="アクセシビリティ" Style="{StaticResource TabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        
                        <!-- フォーカス設定 -->
                        <GroupBox Header="フォーカス設定" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="フォーカス表示を有効にする" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding ShowFocusIndicator}"/>
                                </Grid>
                                
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="フォーカス線幅" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Value="{Binding FocusThickness}" 
                                            Minimum="1" Maximum="5" 
                                            TickFrequency="1" IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!-- キーボード設定 -->
                        <GroupBox Header="キーボード設定" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="キーボードナビゲーションを有効にする" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding EnableKeyboardNavigation}"/>
                                </Grid>
                                
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ショートカットキーを有効にする" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding EnableShortcuts}"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!-- スクリーンリーダー設定 -->
                        <GroupBox Header="スクリーンリーダー設定" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="スクリーンリーダー対応を有効にする" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding EnableScreenReaderSupport}"/>
                                </Grid>
                                
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="詳細な説明を提供" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding ProvideDetailedDescriptions}"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ボタンエリア -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button Content="設定をリセット" Command="{Binding ResetSettingsCommand}" 
                    Margin="0,0,10,0" Padding="15,8"/>
            <Button Content="設定をインポート" Command="{Binding ImportSettingsCommand}" 
                    Margin="0,0,10,0" Padding="15,8"/>
            <Button Content="設定をエクスポート" Command="{Binding ExportSettingsCommand}" 
                    Margin="0,0,10,0" Padding="15,8"/>
            <Button Content="OK" Command="{Binding SaveSettingsCommand}" 
                    IsDefault="True" Padding="15,8" Margin="0,0,10,0"/>
            <Button Content="キャンセル" Command="{Binding CancelCommand}" 
                    IsCancel="True" Padding="15,8"/>
        </StackPanel>
    </Grid>
</Window>
