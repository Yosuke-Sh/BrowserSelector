<Window x:Class="BrowserSelector.Presentation.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BrowserSelector.Presentation.Views"
        xmlns:controls="clr-namespace:BrowserSelector.Presentation.Controls"
        xmlns:enums="clr-namespace:BrowserSelector.Core.Enums"
        xmlns:converters="clr-namespace:BrowserSelector.Presentation.Converters"
        xmlns:extensions="clr-namespace:BrowserSelector.Presentation.Extensions"
        mc:Ignorable="d"
        Title="{extensions:Localization SettingsWindow.Title}" Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinHeight="500" MinWidth="700">

    <Window.Resources>
        <Style x:Key="TabItemStyle" TargetType="TabItem">
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        
        <Style x:Key="GroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        
        <Style x:Key="SettingRowStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,5,0,5"/>
        </Style>
        
        <!-- コンバーター -->
        <converters:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
        <converters:GradientDirectionToIndexConverter x:Key="GradientDirectionToIndexConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- メインコンテンツ -->
        <TabControl Grid.Row="0" Margin="10">
            
            <!-- 一般設定タブ -->
            <TabItem Style="{StaticResource TabItemStyle}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/BrowserSelector.Presentation;component/Resources/Images/Icon_General.png" 
                               Width="18" Height="18" 
                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{extensions:Localization SettingsWindow.General}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        
                        <!-- アプリケーション設定 -->
                        <GroupBox Header="{extensions:Localization Settings.App.ApplicationSettings}" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{extensions:Localization Settings.App.CloseAfterLaunch}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding AppSettings.CloseAfterUrlRuleMatch}"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!-- 言語設定 -->
                        <GroupBox Header="{extensions:Localization Settings.App.LanguageSettings}" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{extensions:Localization Settings.App.Language}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" SelectedItem="{Binding SelectedLanguage}"
                                              ItemsSource="{Binding AvailableLanguages}"
                                              DisplayMemberPath="DisplayName"
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>



                        <!-- アップデート設定 -->
                        <GroupBox Header="{extensions:Localization Settings.App.UpdateSettings}" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{extensions:Localization Settings.App.AutoUpdateCheck}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding AppSettings.CheckForUpdates}"/>
                                </Grid>
                                
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{extensions:Localization Settings.App.UpdateCheckInterval}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding AppSettings.UpdateCheckInterval}" 
                                             VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 表示設定タブ -->
            <TabItem Style="{StaticResource TabItemStyle}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/BrowserSelector.Presentation;component/Resources/Images/Icon_Display.png" 
                               Width="18" Height="18" 
                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="表示" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        
                        <!-- 背景設定 -->
                        <GroupBox Header="背景設定" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <!-- 背景色 -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="背景色" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="色を選択" Padding="10,5"
                                            Command="{Binding SelectBackgroundColorCommand}"/>
                                    <!-- 現在色を可視化 -->
                                    <Border Grid.Column="2" Width="24" Height="24" Margin="10,0,0,0"
                                            BorderBrush="#DDD" BorderThickness="1"
                                            Background="{Binding VisualSettings.BackgroundColor, Converter={StaticResource ColorToBrushConverter}}" />
                                </Grid>

                                <!-- 背景グラデーション -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="背景グラディエーション" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding VisualSettings.UseBackgroundGradient}"/>
                                </Grid>

                                <!-- グラデーション開始色 -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="グラデーション開始色" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="色を選択" Padding="10,5"
                                            Command="{Binding SelectGradientStartColorCommand}"/>
                                    <!-- 現在色を可視化 -->
                                    <Border Grid.Column="2" Width="24" Height="24" Margin="10,0,0,0"
                                            BorderBrush="#DDD" BorderThickness="1"
                                            Background="{Binding VisualSettings.GradientStartColor, Converter={StaticResource ColorToBrushConverter}}" />
                                </Grid>

                                <!-- グラデーション終了色 -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="グラデーション終了色" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="色を選択" Padding="10,5"
                                            Command="{Binding SelectGradientEndColorCommand}"/>
                                    <!-- 現在色を可視化 -->
                                    <Border Grid.Column="2" Width="24" Height="24" Margin="10,0,0,0"
                                            BorderBrush="#DDD" BorderThickness="1"
                                            Background="{Binding VisualSettings.GradientEndColor, Converter={StaticResource ColorToBrushConverter}}" />
                                </Grid>

                                <!-- グラデーション方向 -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="グラデーション方向" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" 
                                              SelectedIndex="{Binding VisualSettings.GradientDirection, Converter={StaticResource GradientDirectionToIndexConverter}}"
                                              VerticalAlignment="Center"
                                              IsEnabled="{Binding VisualSettings.UseBackgroundGradient}"
                                              SelectionChanged="GradientDirectionComboBox_SelectionChanged">
                                        <ComboBoxItem Content="垂直"/>
                                        <ComboBoxItem Content="水平"/>
                                        <ComboBoxItem Content="斜め"/>
                                    </ComboBox>
                                </Grid>


                            </StackPanel>
                        </GroupBox>

                        <!-- ウィンドウ設定 -->
                        <GroupBox Header="ウィンドウ設定" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <!-- 初期起動サイズ -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="初期起動サイズ" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding VisualSettings.InitialWindowWidth}" 
                                             VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Grid.Column="2" Text="×" VerticalAlignment="Center" 
                                               HorizontalAlignment="Center"/>
                                    <TextBox Grid.Column="3" Text="{Binding VisualSettings.InitialWindowHeight}" 
                                             VerticalAlignment="Center"/>
                                </Grid>
                                
                                <!-- ロゴ表示 -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ロゴ表示" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding VisualSettings.ShowLogo}"/>
                                </Grid>
                                
                                <!-- URL入力表示 -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="URL入力表示" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding VisualSettings.ShowUrlInput}"/>
                                </Grid>
                                
                            </StackPanel>
                        </GroupBox>

                        <!-- ブラウザボタン設定 -->
                        <GroupBox Header="ブラウザボタン設定" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <!-- ボタンサイズ -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ボタンサイズ" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding VisualSettings.BrowserButtonWidth}" 
                                             VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Grid.Column="2" Text="×" VerticalAlignment="Center" 
                                               HorizontalAlignment="Center"/>
                                    <TextBox Grid.Column="3" Text="{Binding VisualSettings.BrowserButtonHeight}" 
                                             VerticalAlignment="Center"/>
                                </Grid>

                                <!-- ボタン背景色 -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ボタン背景色" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="色を選択" Padding="10,5"
                                            Command="{Binding SelectBrowserButtonBackgroundColorCommand}"/>
                                    <!-- 現在色を可視化 -->
                                    <Border Grid.Column="2" Width="24" Height="24" Margin="10,0,0,0"
                                            BorderBrush="#DDD" BorderThickness="1"
                                            Background="{Binding VisualSettings.BrowserButtonBackgroundColor, Converter={StaticResource ColorToBrushConverter}}" />
                                </Grid>

                                <!-- ボタンテキスト色 -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ボタンテキスト色" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="色を選択" Padding="10,5"
                                            Command="{Binding SelectBrowserButtonForegroundColorCommand}"/>
                                    <!-- 現在色を可視化 -->
                                    <Border Grid.Column="2" Width="24" Height="24" Margin="10,0,0,0"
                                            BorderBrush="#DDD" BorderThickness="1"
                                            Background="{Binding VisualSettings.BrowserButtonForegroundColor, Converter={StaticResource ColorToBrushConverter}}" />
                                </Grid>

                                <!-- ボタン背景透明化 -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ボタン背景透明化" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="0.1" Maximum="1.0" 
                                            Value="{Binding VisualSettings.BrowserButtonOpacity}"
                                            VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding VisualSettings.BrowserButtonOpacity, StringFormat={}{0:P0}}" 
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Grid>

                                <!-- ボタン角丸半径 -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ボタン角丸半径" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="20" 
                                            Value="{Binding VisualSettings.BrowserButtonCornerRadius}"
                                            VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding VisualSettings.BrowserButtonCornerRadius, StringFormat={}{0:F0}px}" 
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Grid>

                                <!-- ブラウザ名表示 -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ブラウザ名表示" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding VisualSettings.ShowBrowserName}"/>
                                </Grid>

                                <!-- アイコンサイズ -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="アイコンサイズ" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="16" Maximum="64" 
                                            Value="{Binding VisualSettings.BrowserIconSize}"
                                            VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding VisualSettings.BrowserIconSize, StringFormat={}{0:F0}px}" 
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Grid>
                                
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ブラウザ設定タブ -->
            <TabItem Style="{StaticResource TabItemStyle}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/BrowserSelector.Presentation;component/Resources/Images/Icon_Browser.png" 
                               Width="18" Height="18" 
                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="ブラウザ" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <!-- ブラウザ管理 -->
                        <GroupBox Header="ブラウザ管理" Style="{StaticResource GroupBoxStyle}" Height="400">
                            <StackPanel>
                                <TextBlock Text="検出されたブラウザ:" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <ListBox Height="250" ItemsSource="{Binding DetectedBrowsers}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding DisplayOrder}" 
                                                           FontSize="10" Foreground="Gray" 
                                                           VerticalAlignment="Center" Margin="0,0,5,0" Width="20"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0">
                                                    <Button Content="↑" Padding="0,0" FontSize="12" Width="30" Height="30"
                                                            Command="{Binding DataContext.MoveBrowserUpCommand, 
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="↓" Padding="0,0" FontSize="12" Width="30" Height="30"
                                                            Command="{Binding DataContext.MoveBrowserDownCommand, 
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,5,0">
                                                    <TextBlock Text="{Binding Name}" 
                                                               VerticalAlignment="Center" FontSize="12"/>
                                                    <TextBlock Text="{Binding ExecutablePath}" 
                                                               FontSize="9" Foreground="Gray" 
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Button Grid.Column="3" Content="編集" Padding="1,1" FontSize="12"  Width="80" Height="30"
                                                        Margin="2,0,0,0" Command="{Binding DataContext.EditBrowserCommand, 
                                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Grid.Column="4" Content="削除" Padding="1,1" FontSize="12" Width="80" Height="30"
                                                        Margin="2,0,0,0" Command="{Binding DataContext.RemoveBrowserCommand, 
                                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Command="{Binding RefreshBrowsersCommand}" 
                                            Margin="0,0,10,0" Padding="10,5">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Image Source="/BrowserSelector.Presentation;component/Resources/Images/Icon_Refresh.png" 
                                                   Width="18" Height="18" 
                                                   Margin="8,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="ブラウザを再検出" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding AddBrowserCommand}" 
                                            Margin="0,0,10,0" Padding="10,5">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Image Source="/BrowserSelector.Presentation;component/Resources/Images/Icon_Add.png" 
                                                   Width="18" Height="19" 
                                                   Margin="8,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="ブラウザを追加" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- URLルール設定タブ -->
            <TabItem Style="{StaticResource TabItemStyle}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/BrowserSelector.Presentation;component/Resources/Images/Icon_Rules.png" 
                               Width="18" Height="18" 
                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="URLルール" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        
                        <!-- URLルール一覧 -->
                        <GroupBox Header="URLルール一覧" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <TextBlock Text="設定されたURLルール:" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <ListBox Height="200" ItemsSource="{Binding UrlRules}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" 
                                                          IsEnabled="False"
                                                          Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" 
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Priority}" 
                                                           FontSize="10" Foreground="Gray" 
                                                           Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                <Button Grid.Column="3" Content="編集" Padding="5,2" 
                                                        Margin="10,0,0,0" Command="{Binding DataContext.EditUrlRuleCommand, 
                                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Grid.Column="4" Content="削除" Padding="5,2" 
                                                        Margin="10,0,0,0" Command="{Binding DataContext.RemoveUrlRuleCommand, 
                                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Command="{Binding AddUrlRuleCommand}" 
                                            Margin="0,0,10,0" Padding="10,5">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Image Source="/BrowserSelector.Presentation;component/Resources/Images/Icon_Add.png" 
                                                   Width="18" Height="19" 
                                                   Margin="8,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="ルールを追加" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding RefreshUrlRulesCommand}" 
                                            Margin="0,0,10,0" Padding="10,5">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Image Source="/BrowserSelector.Presentation;component/Resources/Images/Icon_Refresh.png" 
                                                   Width="18" Height="18" 
                                                   Margin="8,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="ルールを更新" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- ルールテスト -->
                        <GroupBox Header="ルールテスト" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="テストURL:" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Command="{Binding TestUrlRuleCommand}" 
                                            Content="テスト" Padding="10,5"/>
                                </Grid>
                                
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding TestUrl}" 
                                             VerticalAlignment="Center" 
                                             ToolTip="テストしたいURLを入力してください"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TestResult}" 
                                               VerticalAlignment="Center" 
                                               Margin="10,0,0,0" 
                                               Foreground="{Binding TestResultColor}"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- アクセシビリティ設定タブ（当面非表示） -->
            <TabItem Style="{StaticResource TabItemStyle}" Visibility="Collapsed">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/BrowserSelector.Presentation;component/Resources/Images/Icon_Accessibility.png" 
                               Width="18" Height="18" 
                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="アクセシビリティ" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        
                        <!-- フォーカス設定 -->
                        <GroupBox Header="フォーカス設定" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="フォーカス表示を有効にする" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding ShowFocusIndicator}"/>
                                </Grid>
                                
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="フォーカス線幅" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Value="{Binding FocusThickness}" 
                                            Minimum="1" Maximum="5" 
                                            TickFrequency="1" IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!-- キーボード設定 -->
                        <GroupBox Header="キーボード設定" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="キーボードナビゲーションを有効にする" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding EnableKeyboardNavigation}"/>
                                </Grid>
                                
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ショートカットキーを有効にする" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding EnableShortcuts}"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!-- スクリーンリーダー設定 -->
                        <GroupBox Header="スクリーンリーダー設定" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="スクリーンリーダー対応を有効にする" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding EnableScreenReaderSupport}"/>
                                </Grid>
                                
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="詳細な説明を提供" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding ProvideDetailedDescriptions}"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ログ設定タブ -->
            <TabItem Style="{StaticResource TabItemStyle}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/BrowserSelector.Presentation;component/Resources/Images/Icon_Log.png" 
                               Width="18" Height="18" 
                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="ログ設定" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        
                        <!-- 基本ログ設定 -->
                        <GroupBox Header="基本ログ設定" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ログを有効にする" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding LogSettings.EnableLogging}"/>
                                </Grid>
                                
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ログレベル" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" SelectedItem="{Binding SelectedLogLevel}"
                                              ItemsSource="{Binding AvailableLogLevels}"
                                              DisplayMemberPath="DisplayName"
                                              VerticalAlignment="Center"/>
                                </Grid>
                                
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="コンソールにログを出力" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding LogSettings.EnableConsoleLogging}"/>
                                </Grid>
                                
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ファイルにログを出力" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding LogSettings.EnableFileLogging}"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!-- ファイルログ設定 -->
                        <GroupBox Header="ファイルログ設定" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ログ出力フォルダ" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="フォルダ選択" Padding="10,5"
                                            Command="{Binding SelectLogFolderCommand}"/>
                                </Grid>
                                
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="最大ログファイルサイズ（MB）" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding LogSettings.MaxLogFileSize}" 
                                             VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                                
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ログ保持期間（日数）" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding LogSettings.LogRetentionDays}" 
                                             VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                                
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ログファイル名プレフィックス" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding LogSettings.LogFilePrefix}" 
                                             Width="150" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!-- ログ管理 -->
                        <GroupBox Header="ログ管理" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="現在のログファイル" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CurrentLogFilePath}" 
                                               Foreground="Gray" FontSize="10" VerticalAlignment="Center"/>
                                </Grid>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Command="{Binding ViewLogsCommand}" Margin="0,0,10,0" Padding="10,5">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Image Source="/BrowserSelector.Presentation;component/Resources/Images/Icon_View.png" 
                                                   Width="18" Height="18" 
                                                   Margin="8,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="ログを表示" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding ClearLogsCommand}" Margin="0,0,10,0" Padding="10,5">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Image Source="/BrowserSelector.Presentation;component/Resources/Images/Icon_Clear.png" 
                                                   Width="18" Height="18" 
                                                   Margin="8,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="ログをクリア" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding CleanupOldLogsCommand}" Padding="10,5">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Image Source="/BrowserSelector.Presentation;component/Resources/Images/Icon_Cleanup.png" 
                                                   Width="18" Height="18" 
                                                   Margin="8,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="古いログを削除" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ボタンエリア -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button Command="{Binding ResetSettingsCommand}" 
                    Margin="0,0,10,0" Padding="15,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Source="/BrowserSelector.Presentation;component/Resources/Images/Icon_Reset.png" 
                           Width="18" Height="18" 
                           Margin="8,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="設定をリセット" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding ImportSettingsCommand}" 
                    Margin="0,0,10,0" Padding="15,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Source="/BrowserSelector.Presentation;component/Resources/Images/Icon_Import.png" 
                           Width="18" Height="18" 
                           Margin="8,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="設定をインポート" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding ExportSettingsCommand}" 
                    Margin="0,0,10,0" Padding="15,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Source="/BrowserSelector.Presentation;component/Resources/Images/Icon_Export.png" 
                           Width="18" Height="18" 
                           Margin="8,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="設定をエクスポート" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding SaveSettingsCommand}" 
                    IsDefault="True" Padding="15,8" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Source="/BrowserSelector.Presentation;component/Resources/Images/Icon_Check.png" 
                           Width="18" Height="18" 
                           Margin="8,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="OK" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding CancelCommand}" 
                    IsCancel="True" Padding="15,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Source="/BrowserSelector.Presentation;component/Resources/Images/Icon_Close.png" 
                           Width="18" Height="18" 
                           Margin="8,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="キャンセル" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
