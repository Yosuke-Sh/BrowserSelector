<Window x:Class="BrowserSelector.Presentation.Views.LanguageManagementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:extensions="clr-namespace:BrowserSelector.Presentation.Extensions"
        xmlns:converters="clr-namespace:BrowserSelector.Presentation.Converters"
        Title="{extensions:Localization Settings.App.LanguageSettings}" 
        Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    
    <Window.Resources>
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>
        
        <Style x:Key="GroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        
        <!-- Boolean反転コンバーター -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InvertBooleanConverter x:Key="InvertBooleanConverter"/>
        
        <Style x:Key="SettingRowStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- メインコンテンツ -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                
                <!-- 利用可能な言語一覧 -->
                <GroupBox Header="{extensions:Localization Settings.App.LanguageSettings}" Style="{StaticResource GroupBoxStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- 言語一覧 -->
                        <ListBox Grid.Row="1" 
                                 ItemsSource="{Binding AvailableLanguages}"
                                 SelectedItem="{Binding SelectedLanguage}"
                                 DisplayMemberPath="DisplayName"
                                 MinHeight="200"
                                 Margin="0,10"/>
                        
                        <!-- 操作ボタン -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{extensions:Localization Common.Refresh}" 
                                    Command="{Binding RefreshLanguagesCommand}"
                                    Style="{StaticResource ButtonStyle}"/>
                            <Button Content="検証" 
                                    Command="{Binding ValidateLanguageFileCommand}"
                                    Style="{StaticResource ButtonStyle}"/>
                            <Button Content="削除" 
                                    Command="{Binding RemoveCustomLanguageCommand}"
                                    Style="{StaticResource ButtonStyle}"
                                    Background="LightCoral"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- 新しい言語の追加 -->
                <GroupBox Header="新しい言語の追加" Style="{StaticResource GroupBoxStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="言語選択:" VerticalAlignment="Center" Width="100"/>
                            <ComboBox Grid.Column="1" 
                                      ItemsSource="{Binding AvailableLanguageCodes}"
                                      SelectedItem="{Binding SelectedLanguageCode}"
                                      DisplayMemberPath="DisplayName"
                                      ToolTip="言語を選択してください"/>
                        </Grid>
                        
                        <Grid Style="{StaticResource SettingRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="言語コード:" VerticalAlignment="Center" Width="100"/>
                            <TextBox Grid.Column="1" 
                                     Text="{Binding NewLanguageCode}"
                                     IsReadOnly="True"
                                     Background="LightGray"
                                     ToolTip="選択した言語のコード"/>
                        </Grid>
                        
                        <Grid Style="{StaticResource SettingRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="表示名:" VerticalAlignment="Center" Width="100"/>
                            <TextBox Grid.Column="1" 
                                     Text="{Binding NewLanguageName}"
                                     IsReadOnly="True"
                                     Background="LightGray"
                                     ToolTip="選択した言語の表示名"/>
                        </Grid>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Content="テンプレート生成" 
                                    Command="{Binding GenerateLanguageTemplateCommand}"
                                    IsEnabled="{Binding IsGeneratingTemplate, Converter={StaticResource InvertBooleanConverter}}"
                                    Style="{StaticResource ButtonStyle}"
                                    Background="LightGreen"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- 言語ファイル管理 -->
                <GroupBox Header="言語ファイル管理" Style="{StaticResource GroupBoxStyle}">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                            言語ファイルは以下のフォルダに保存されます：
                            <LineBreak/>
                            %AppData%\BrowserSelector\Languages\
                        </TextBlock>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="言語フォルダを開く" 
                                    Command="{Binding OpenLanguageFolderCommand}"
                                    Style="{StaticResource ButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- ステータスメッセージ -->
                <GroupBox Header="ステータス" Style="{StaticResource GroupBoxStyle}">
                    <TextBlock Text="{Binding StatusMessage}" 
                               TextWrapping="Wrap"
                               Foreground="Blue"/>
                </GroupBox>
                
            </StackPanel>
        </ScrollViewer>

        <!-- ボタンエリア -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button Content="{extensions:Localization Common.Close}" 
                    Click="CloseButton_Click"
                    Style="{StaticResource ButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
