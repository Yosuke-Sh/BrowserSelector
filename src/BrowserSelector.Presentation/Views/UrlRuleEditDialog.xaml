<Window x:Class="BrowserSelector.Presentation.Views.UrlRuleEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:BrowserSelector.Presentation.Converters"
        mc:Ignorable="d"
        Title="URLルール編集" Height="500" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinHeight="400" MinWidth="500">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <TextBlock Grid.Row="0" Text="URLルール設定" 
                   FontSize="18" FontWeight="Bold" 
                   Margin="0,0,0,20" HorizontalAlignment="Center"/>

        <!-- メインコンテンツ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- パターン設定 -->
                <GroupBox Header="URLパターン" Margin="0,0,0,15">
                    <StackPanel Margin="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="パターン:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Column="1" Text="{Binding UrlRule.Pattern}" Style="{StaticResource InputStyle}"
                                     ToolTip="例: *.google.com, http*, *.github.com/*"/>
                        </Grid>
                        <TextBlock Text="例: *.google.com, http*, *.github.com/*" 
                                   FontSize="11" Foreground="Gray" Margin="110,0,0,0"/>
                    </StackPanel>
                </GroupBox>

                <!-- ブラウザ設定 -->
                <GroupBox Header="対象ブラウザ" Margin="0,0,0,15">
                    <StackPanel Margin="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ブラウザ:" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Grid.Column="1" SelectedItem="{Binding SelectedBrowser}" 
                                      ItemsSource="{Binding AvailableBrowsers}"
                                      DisplayMemberPath="Name" Margin="0,0,0,10"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- 優先度設定 -->
                <GroupBox Header="優先度設定" Margin="0,0,0,15">
                    <StackPanel Margin="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="優先度:" Style="{StaticResource LabelStyle}"/>
                            <Slider Grid.Column="1" Value="{Binding UrlRule.Priority}" 
                                    Minimum="1" Maximum="100" 
                                    TickFrequency="10" IsSnapToTickEnabled="True"
                                    Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding UrlRule.Priority}" 
                                       FontWeight="Bold" MinWidth="30" 
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="数値が大きいほど優先度が高くなります" 
                                   FontSize="11" Foreground="Gray" Margin="110,0,0,0"/>
                    </StackPanel>
                </GroupBox>

                <!-- その他設定 -->
                <GroupBox Header="その他設定" Margin="0,0,0,15">
                    <StackPanel Margin="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="有効:" Style="{StaticResource LabelStyle}"/>
                            <CheckBox Grid.Column="1" IsChecked="{Binding UrlRule.IsEnabled}" 
                                      Content="このルールを有効にする" 
                                      VerticalAlignment="Center" Margin="0,0,0,10"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="説明:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Column="1" Text="{Binding UrlRule.Description}" 
                                     Style="{StaticResource InputStyle}"
                                     ToolTip="ルールの説明（任意）"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- ボタン -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" 
                    HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="キャンセル" IsCancel="True" Style="{StaticResource ButtonStyle}"/>
            <Button Content="OK" IsDefault="True" Style="{StaticResource ButtonStyle}"
                    Click="OkButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
