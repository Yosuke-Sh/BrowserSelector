<Window x:Class="BrowserSelector.Presentation.Views.UrlRuleEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:BrowserSelector.Presentation.Converters"
        xmlns:extensions="clr-namespace:BrowserSelector.Presentation.Extensions"
        mc:Ignorable="d"
        Title="{extensions:Localization Dialog.UrlRuleEdit.Title}" Height="500" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinHeight="400" MinWidth="500">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <TextBlock Grid.Row="0" Text="{extensions:Localization Dialog.UrlRuleEdit.UrlRuleSettings}" 
                   FontSize="18" FontWeight="Bold" 
                   Margin="0,0,0,20" HorizontalAlignment="Center"/>

        <!-- メインコンテンツ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- パターン設定 -->
                <GroupBox Header="{extensions:Localization Dialog.UrlRuleEdit.UrlPattern}" Margin="0,0,0,15">
                    <StackPanel Margin="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{extensions:Localization Dialog.UrlRuleEdit.Pattern}" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="PatternTextBox" Grid.Column="1" Text="{Binding UrlRule.Pattern}" Style="{StaticResource InputStyle}"
                                     ToolTip="{extensions:Localization Dialog.UrlRuleEdit.PatternTooltip}"/>
                            <Button Grid.Column="2" Content="{extensions:Localization Dialog.UrlRuleEdit.ImportCurrentUrl}"
                                    Margin="10,0,0,10" Padding="8,5"
                                    IsEnabled="{Binding CanImportCurrentUrl}"
                                    ToolTip="{Binding CurrentUrl}"
                                    Click="ImportCurrentUrlButton_Click"
                                    AutomationProperties.Name="ImportCurrentUrlButton"/>
                        </Grid>
                        <TextBlock Text="{extensions:Localization Dialog.UrlRuleEdit.PatternExample}"
                                   FontSize="11" Foreground="Gray" Margin="110,0,0,0"/>
                    </StackPanel>
                </GroupBox>

                <!-- ブラウザ設定 -->
                <GroupBox Header="{extensions:Localization Dialog.UrlRuleEdit.TargetBrowser}" Margin="0,0,0,15">
                    <StackPanel Margin="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{extensions:Localization Dialog.UrlRuleEdit.Browser}" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Grid.Column="1" SelectedItem="{Binding SelectedBrowser}" 
                                      ItemsSource="{Binding AvailableBrowsers}"
                                      DisplayMemberPath="Name" Margin="0,0,0,10"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- 優先度設定 -->
                <GroupBox Header="{extensions:Localization Dialog.UrlRuleEdit.PrioritySettings}" Margin="0,0,0,15">
                    <StackPanel Margin="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{extensions:Localization Dialog.UrlRuleEdit.Priority}" Style="{StaticResource LabelStyle}"/>
                            <Slider Grid.Column="1" Value="{Binding UrlRule.Priority}" 
                                    Minimum="1" Maximum="100" 
                                    TickFrequency="10" IsSnapToTickEnabled="True"
                                    Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding UrlRule.Priority}" 
                                       FontWeight="Bold" MinWidth="30" 
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{extensions:Localization Dialog.UrlRuleEdit.PriorityDescription}" 
                                   FontSize="11" Foreground="Gray" Margin="110,0,0,0"/>
                    </StackPanel>
                </GroupBox>

                <!-- その他設定 -->
                <GroupBox Header="{extensions:Localization Dialog.UrlRuleEdit.OtherSettings}" Margin="0,0,0,15">
                    <StackPanel Margin="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{extensions:Localization Dialog.UrlRuleEdit.Enabled}" Style="{StaticResource LabelStyle}"/>
                            <CheckBox Grid.Column="1" IsChecked="{Binding UrlRule.IsEnabled}" 
                                      Content="{extensions:Localization Dialog.UrlRuleEdit.EnableRule}" 
                                      VerticalAlignment="Center" Margin="0,0,0,10"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{extensions:Localization Dialog.UrlRuleEdit.Description}" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Column="1" Text="{Binding UrlRule.Description}" 
                                     Style="{StaticResource InputStyle}"
                                     ToolTip="{extensions:Localization Dialog.UrlRuleEdit.DescriptionTooltip}"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- ボタン -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" 
                    HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{extensions:Localization Common.OK}" IsDefault="True" Style="{StaticResource ButtonStyle}"
                    Margin="0,0,10,0" Click="OkButton_Click"/>
            <Button Content="{extensions:Localization Common.Cancel}" IsCancel="True" Style="{StaticResource ButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
